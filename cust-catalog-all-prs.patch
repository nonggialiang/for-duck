+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import org.apache.gravitino.listener.api.event.OperationStatus;
+import org.apache.gravitino.listener.api.event.OperationType;
+import org.apache.iceberg.catalog.TableIdentifier;
+
+/**
+ * Event published when a concurrent first-write materialization race is lost (spec §5.6.3).
+ *
+ * <p>This corresponds to {@code CustTableOperations.commit} catching {@code AlreadyExistsException}
+ * or detecting an already-materialized table, and throwing {@code CommitFailedException}.
+ */
+public class CustConflictEvent extends CustEvent {
+
+  private final String conflictReason;
+
+  /**
+   * Constructs a conflict event.
+   *
+   * @param catalogName the cust catalog name.
+   * @param identifier the Iceberg table identifier that had a conflict.
+   * @param conflictReason a short human-readable reason (e.g. "pre-check" or "cas-failure").
+   */
+  public CustConflictEvent(String catalogName, TableIdentifier identifier, String conflictReason) {
+    super(catalogName, identifier);
+    this.conflictReason = conflictReason;
+  }
+
+  /** Returns the conflict reason. */
+  public String conflictReason() {
+    return conflictReason;
+  }
+
+  @Override
+  public OperationType operationType() {
+    return OperationType.CREATE_TABLE;
+  }
+
+  @Override
+  public OperationStatus operationStatus() {
+    return OperationStatus.FAILURE;
+  }
+}
