+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import com.google.common.collect.Maps;
+import java.time.Instant;
+import java.util.Map;
+import org.apache.gravitino.Catalog;
+import org.apache.gravitino.Namespace;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergConstants;
+import org.apache.gravitino.connector.HasPropertyMetadata;
+import org.apache.gravitino.connector.PropertiesMetadata;
+import org.apache.gravitino.meta.AuditInfo;
+import org.apache.gravitino.meta.CatalogEntity;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for {@link CustCatalogOperations}.
+ *
+ * <p>For PR 1 the scope is narrow: validate that {@link CustCatalogOperations#initialize} enforces
+ * the cust-catalog-specific invariants (required {@code upstream-catalog}, forced JDBC backend) on
+ * top of the inherited {@link
+ * org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalogOperations} behavior.
+ */
+public class TestCustCatalogOperations {
+
+  /**
+   * Builds a HasPropertyMetadata that returns the cust catalog metadata for catalog-level queries
+   * and the standard Iceberg schema/table metadata for entity-level queries. This is exactly the
+   * shape that {@code BaseCatalog.ops()} passes into {@code CatalogOperations.initialize(...)} at
+   * runtime.
+   */
+  private static HasPropertyMetadata buildPropertiesMetadata() {
+    final CustCatalog catalog = new CustCatalog();
+    return new HasPropertyMetadata() {
+      @Override
+      public PropertiesMetadata tablePropertiesMetadata() throws UnsupportedOperationException {
+        return catalog.tablePropertiesMetadata();
+      }
+
+      @Override
+      public PropertiesMetadata catalogPropertiesMetadata() throws UnsupportedOperationException {
+        return catalog.catalogPropertiesMetadata();
+      }
+
+      @Override
+      public PropertiesMetadata schemaPropertiesMetadata() throws UnsupportedOperationException {
+        return catalog.schemaPropertiesMetadata();
+      }
+
+      @Override
+      public PropertiesMetadata filesetPropertiesMetadata() throws UnsupportedOperationException {
+        throw new UnsupportedOperationException("Fileset properties are not supported");
+      }
+
+      @Override
+      public PropertiesMetadata topicPropertiesMetadata() throws UnsupportedOperationException {
+        throw new UnsupportedOperationException("Topic properties are not supported");
+      }
+
+      @Override
+      public PropertiesMetadata modelPropertiesMetadata() throws UnsupportedOperationException {
+        throw new UnsupportedOperationException("Model properties are not supported");
+      }
+
+      @Override
+      public PropertiesMetadata modelVersionPropertiesMetadata()
+          throws UnsupportedOperationException {
+        throw new UnsupportedOperationException("Does not support model version properties");
+      }
+    };
+  }
+
+  private static CatalogEntity buildEntity() {
+    AuditInfo auditInfo =
+        AuditInfo.builder().withCreator("creator").withCreateTime(Instant.now()).build();
+    return CatalogEntity.builder()
+        .withId(1L)
+        .withName("cust-a")
+        .withNamespace(Namespace.of("metalake"))
+        .withType(Catalog.Type.RELATIONAL)
+        .withProvider("cust")
+        .withAuditInfo(auditInfo)
+        .build();
+  }
+
+  /** SQLite-backed JDBC config — matches the iceberg-common test setup. */
+  private static Map<String, String> sqliteJdbcConfig() {
+    Map<String, String> conf = Maps.newHashMap();
+    conf.put(IcebergConstants.URI, "jdbc:sqlite::memory:");
+    conf.put(IcebergConstants.GRAVITINO_JDBC_DRIVER, "org.sqlite.JDBC");
+    conf.put(IcebergConstants.WAREHOUSE, "/tmp/cust-warehouse-test");
+    return conf;
+  }
+
+  /**
+   * Validates that {@link CustCatalogOperations#initialize} rejects a config that does not carry
+   * the required {@code upstream-catalog} property — without ever attempting to open a JDBC
+   * connection (validation happens before delegating to the parent {@code
+   * IcebergCatalogOperations#initialize}).
+   */
+  @Test
+  void testInitializeRejectsMissingUpstreamCatalog() {
+    Map<String, String> conf = sqliteJdbcConfig();
+    // intentionally omit upstream-catalog
+    try (CustCatalogOperations ops = new CustCatalogOperations()) {
+      IllegalArgumentException ex =
+          Assertions.assertThrows(
+              IllegalArgumentException.class,
+              () -> ops.initialize(conf, buildEntity().toCatalogInfo(), buildPropertiesMetadata()));
+      Assertions.assertTrue(
+          ex.getMessage().contains(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG));
+    }
+  }
+
+  /**
+   * Validates that {@link CustCatalogOperations#initialize} forces the underlying Iceberg backend
+   * to {@code jdbc} even when the caller supplies a different backend. We assert the operation
+   * completes successfully (which means super.initialize ran with jdbc); we cannot directly inspect
+   * the effective conf, but a memory-backend initialization without {@code jdbc-driver} would
+   * succeed and a jdbc-backend initialization without {@code jdbc-driver} would fail. We rely on
+   * the latter behavior: if backend override didn't happen, the test would not throw on a missing
+   * driver.
+   */
+  @Test
+  void testInitializeForcesJdbcBackend() {
+    Map<String, String> conf = sqliteJdbcConfig();
+    conf.put(IcebergConstants.CATALOG_BACKEND, "memory"); // caller tries to use memory backend
+    conf.put(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG, "catalog-b");
+
+    try (CustCatalogOperations ops = new CustCatalogOperations()) {
+      // With JDBC backend forced, this must succeed because we provided jdbc-driver + uri.
+      Assertions.assertDoesNotThrow(
+          () -> ops.initialize(conf, buildEntity().toCatalogInfo(), buildPropertiesMetadata()));
+    }
+  }
+
+  /**
+   * Smoke test: end-to-end initialize() of a cust catalog backed by SQLite succeeds. This is the PR
+   * 1 acceptance test: "可创建一个 cust 类型 catalog，连接测试通过". Successful initialize means the JDBC backend
+   * was constructed, the IcebergCatalogWrapper was created, and JdbcCatalog's schema initialization
+   * (creating the {@code iceberg_tables} / {@code iceberg_namespace_properties} tables in the
+   * in-memory SQLite DB) ran without error.
+   */
+  @Test
+  void testInitializeSucceedsWithJdbcBackend() {
+    Map<String, String> conf = sqliteJdbcConfig();
+    conf.put(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG, "catalog-b");
+
+    try (CustCatalogOperations ops = new CustCatalogOperations()) {
+      Assertions.assertDoesNotThrow(
+          () -> ops.initialize(conf, buildEntity().toCatalogInfo(), buildPropertiesMetadata()));
+    }
+  }
+
+  /**
+   * Validates that a caller-supplied non-JDBC backend value is logged but does not cause
+   * initialization to fail — the forced JDBC override is silent from the caller's perspective.
+   */
+  @Test
+  void testInitializeOverridesHiveBackendSilently() {
+    Map<String, String> conf = sqliteJdbcConfig();
+    // Caller tries to set hive backend — should be overridden to jdbc without error.
+    conf.put(IcebergConstants.CATALOG_BACKEND, "hive");
+    conf.put(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG, "catalog-b");
+
+    try (CustCatalogOperations ops = new CustCatalogOperations()) {
+      Assertions.assertDoesNotThrow(
+          () -> ops.initialize(conf, buildEntity().toCatalogInfo(), buildPropertiesMetadata()));
+      // If override didn't happen, the catalog would try to connect to a Hive metastore at the
+      // (absent) thrift URI and throw. Successful return proves jdbc was forced.
+    }
+  }
+}
