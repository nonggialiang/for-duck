+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import org.apache.iceberg.catalog.Catalog;
+
+/**
+ * Resolves the upstream catalog (catalog-b) reference by name.
+ *
+ * <p>The cust catalog (catalog-a) is deployed in the same metalake and the same Iceberg REST Server
+ * instance as its upstream. At runtime, the REST server side registers an {@code UpstreamLookup}
+ * implementation that consults {@code IcebergCatalogWrapperManager} to resolve catalog-b. Unit
+ * tests inject a mock implementation directly via the {@link
+ * CustIcebergCatalog#CustIcebergCatalog(UpstreamLookup)} constructor.
+ *
+ * <p>The lookup returns a raw Iceberg {@link Catalog} (not a Gravitino wrapper) so that the cust
+ * module has no compile-time dependency on the {@code iceberg-rest-server} module.
+ *
+ * <p>Implementations must be thread-safe: load routing on catalog-a can be invoked concurrently
+ * from multiple REST worker threads.
+ */
+@FunctionalInterface
+public interface UpstreamLookup {
+
+  /**
+   * Loads the upstream Iceberg {@link Catalog} by name.
+   *
+   * @param upstreamCatalogName the catalog-b name (from the {@code upstream-catalog} property)
+   * @return the upstream Iceberg catalog; never {@code null}
+   * @throws org.apache.iceberg.exceptions.NoSuchCatalogException if the upstream catalog does not
+   *     exist in the same REST Server instance
+   * @throws IllegalStateException if the lookup has not been wired (e.g. unit-test setup missing)
+   */
+  Catalog loadUpstream(String upstreamCatalogName);
+}
