+  // ==================== DDL overrides (spec §5.3) ====================
+
+  /**
+   * Creates a new LOCAL_ONLY table in catalog-a (spec §5.3.1).
+   *
+   * <p>Rejects the create if the table exists in either catalog-a (local) or catalog-b (upstream).
+   * The upstream check prevents accidental shadowing of a catalog-b table — if users want a
+   * materialized mirror they must go through the first-write path (PR 3), not CREATE TABLE.
+   *
+   * @throws AlreadyExistsException if the table exists locally or upstream
+   */
+  @Override
+  public Table createTable(
+      TableIdentifier identifier,
+      Schema schema,
+      PartitionSpec spec,
+      String location,
+      Map<String, String> properties) {
+    if (localTableExists(identifier)) {
+      throw new AlreadyExistsException("Table already exists in catalog-a (local): %s", identifier);
+    }
+    if (upstream().tableExists(identifier)) {
+      throw new AlreadyExistsException(
+          "Table already exists in upstream catalog-b (use the first-write path to materialize "
+              + "a mirror): %s",
