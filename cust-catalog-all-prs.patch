+ *       upstream-only namespaces.
+ *   <li>{@code viewLocalOnly}: VIEW operations go through the local catalog only and do not
+ *       participate in mirroring.
+ * </ol>
+ *
+ * <p>The upstream catalog is a Mockito mock implementing both {@link
+ * org.apache.iceberg.catalog.Catalog} and {@link SupportsNamespaces} (standard for JDBC, Hive, REST
+ * catalogs). The local side is a real SQLite-backed JdbcCatalog via {@link CustIcebergCatalog}.
+ */
+public class TestCustDdl {
+
+  private static final String UPSTREAM_CATALOG_NAME = "catalog-b";
+
+  @TempDir File tempDir;
+
+  private CustIcebergCatalog catalog;
+  private org.apache.iceberg.catalog.Catalog mockUpstream;
+  private SupportsNamespaces mockUpstreamNs;
+  private UpstreamLookup mockLookup;
+
+  private String localWarehouse;
+
+  @BeforeEach
+  void setUp() {
+    // The upstream must implement both Catalog (for table ops) and SupportsNamespaces (for
+    // namespace ops) because CustIcebergCatalog casts the upstream via upstreamNamespaces().
+    mockUpstream =
+        mock(
+            org.apache.iceberg.catalog.Catalog.class,
+            withSettings().extraInterfaces(SupportsNamespaces.class));
+    mockUpstreamNs = (SupportsNamespaces) mockUpstream;
+    mockLookup = name -> mockUpstream;
+    localWarehouse = tempDir.toPath().resolve("warehouse").toString();
+    catalog = new CustIcebergCatalog(mockLookup);
+    catalog.setConf(new org.apache.hadoop.hdfs.HdfsConfiguration());
+    catalog.initialize("cust-a", baseProps());
+  }
+
+  @AfterEach
+  void tearDown() {
+    if (catalog != null) {
+      try {
+        catalog.close();
+      } catch (Exception ignored) {
+        // Best-effort cleanup.
+      }
+    }
+  }
+
+  /** SQLite-backed config matching the iceberg-common test setup. */
+  private Map<String, String> baseProps() {
+    Map<String, String> p = new HashMap<>();
+    p.put(CatalogProperties.WAREHOUSE_LOCATION, localWarehouse);
+    p.put(CatalogProperties.URI, "jdbc:sqlite::memory:");
+    p.put(IcebergConstants.GRAVITINO_JDBC_DRIVER, "org.sqlite.JDBC");
+    p.put("upstream-catalog", UPSTREAM_CATALOG_NAME);
+    p.put(IcebergConstants.ICEBERG_JDBC_SCHEMA_VERSION, "V1");
+    p.put(IcebergConstants.ICEBERG_JDBC_STRICT_MODE, "false");
+    return p;
+  }
+
+  private static Schema simpleSchema() {
+    return new Schema(List.of(NestedField.optional(1, "id", Types.LongType.get())));
+  }
+
+  // ==================== Test 1: createTableConflictWithUpstream (spec §5.3.1) ====================
+
+  /**
+   * CREATE TABLE must be rejected when catalog-b already has a table with the same identifier. This
+   * prevents accidental shadowing of an upstream table — if users want a materialized mirror they
+   * must go through the first-write path (PR 3), not CREATE TABLE.
+   */
+  @Test
+  void testCreateTableConflictWithUpstream() {
+    Namespace ns = Namespace.of("ns_create_conflict");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_conflict");
+
+    // Upstream already has this table.
+    when(mockUpstream.tableExists(ident)).thenReturn(true);
+
+    // CREATE TABLE on catalog-a must fail.
+    AlreadyExistsException ex =
+        Assertions.assertThrows(
+            AlreadyExistsException.class,
+            () -> catalog.createTable(ident, simpleSchema()),
+            "createTable should reject when upstream already has the same-named table");
+    Assertions.assertTrue(
+        ex.getMessage().contains("upstream"),
+        "exception message should mention upstream: " + ex.getMessage());
+
+    // The table must NOT have been created locally either.
+    Assertions.assertFalse(
+        localTableExists(ident), "table must not be created locally after upstream conflict");
+
+    // Upstream was consulted.
+    verify(mockUpstream).tableExists(ident);
+  }
+
+  /** CREATE TABLE succeeds when neither local nor upstream has the table (LOCAL_ONLY state). */
+  @Test
+  void testCreateTableSucceedsWhenNeitherSide() {
+    Namespace ns = Namespace.of("ns_create_ok");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_ok");
+
+    when(mockUpstream.tableExists(ident)).thenReturn(false);
+
+    catalog.createTable(ident, simpleSchema());
+
+    Assertions.assertTrue(catalog.tableExists(ident), "table should exist locally after create");
+    // Upstream was consulted for the conflict check but the table was created locally only.
+    verify(mockUpstream).tableExists(ident);
+    verify(mockUpstream, never()).createTable(any(), any(), any(), any(), any());
+  }
+
+  // ==================== Test 2: dropTableScopeIsolation (spec §5.3.2) ====================
+
+  /**
+   * DROP TABLE on a locally-materialized table must:
+   *
+   * <ol>
+   *   <li>Succeed — the local entry is removed.
+   *   <li>Never call the upstream's dropTable — catalog-b is untouched.
+   *   <li>Still report the table as existing from the upstream's perspective (scope isolation).
+   * </ol>
+   *
+   * <p>The purge flag only affects files under catalog-a's warehouse. Since {@code super.dropTable}
+   * uses the local FileIO (configured for the local warehouse), purge is inherently scoped — it
+   * cannot reach catalog-b's storage.
+   */
+  @Test
+  void testDropTableScopeIsolation() {
+    Namespace ns = Namespace.of("ns_drop");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_drop");
+
+    // Create the table locally first.
+    catalog.createTable(ident, simpleSchema());
+    Assertions.assertTrue(catalog.tableExists(ident), "precondition: table exists locally");
+
+    // Simulate that catalog-b also has this table (the materialized mirror scenario).
+    when(mockUpstream.tableExists(ident)).thenReturn(true);
+
+    // Drop with purge=true from catalog-a.
+    boolean dropped = catalog.dropTable(ident, true);
+
+    Assertions.assertTrue(dropped, "dropTable should return true for successful local drop");
+    Assertions.assertFalse(
+        localTableExists(ident), "table must be gone from local JDBC after drop");
+
+    // The upstream's dropTable must NEVER be called — scope isolation.
+    verify(mockUpstream, never()).dropTable(any());
+    verify(mockUpstream, never()).dropTable(any(), org.mockito.ArgumentMatchers.anyBoolean());
+
+    // The upstream still reports the table exists (it was never touched).
+    when(mockUpstream.tableExists(ident)).thenReturn(true);
+    Assertions.assertTrue(mockUpstream.tableExists(ident), "upstream should still have the table");
+  }
+
+  /**
+   * DROP TABLE on an unmaterialized mirror (exists only upstream) must be rejected with {@link
+   * ForbiddenException} — catalog-a has nothing to drop.
+   */
+  @Test
+  void testDropTableRejectsUnmaterializedMirror() {
+    Namespace ns = Namespace.of("ns_drop_mirror");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_mirror");
+
+    // Table exists only upstream.
+    when(mockUpstream.tableExists(ident)).thenReturn(true);
+
+    Assertions.assertThrows(
+        ForbiddenException.class,
+        () -> catalog.dropTable(ident),
+        "dropping an unmaterialized mirror should be forbidden");
+
+    // Upstream's dropTable was never called.
+    verify(mockUpstream, never()).dropTable(any());
+  }
+
+  // ==================== Test 3: renameUnmaterializedRejected (spec §5.3.3) ====================
+
+  /**
+   * RENAME TABLE on an unmaterialized mirror (exists only upstream) must be rejected with {@link
+   * ForbiddenException} — catalog-a has nothing to rename.
+   */
+  @Test
+  void testRenameUnmaterializedRejected() {
+    Namespace ns = Namespace.of("ns_rename");
+    TableIdentifier from = TableIdentifier.of(ns, "tbl_from");
+    TableIdentifier to = TableIdentifier.of(ns, "tbl_to");
+
+    // Table exists only upstream.
+    when(mockUpstream.tableExists(from)).thenReturn(true);
+
+    Assertions.assertThrows(
+        ForbiddenException.class,
+        () -> catalog.renameTable(from, to),
+        "renaming an unmaterialized mirror should be forbidden");
+
+    // Upstream's renameTable was never called.
+    verify(mockUpstream, never()).renameTable(any(), any());
+  }
+
+  /** RENAME TABLE on a locally-materialized table succeeds and never touches the upstream. */
+  @Test
+  void testRenameMaterializedSucceeds() {
+    Namespace ns = Namespace.of("ns_rename_ok");
+    TableIdentifier from = TableIdentifier.of(ns, "tbl_from_ok");
+    TableIdentifier to = TableIdentifier.of(ns, "tbl_to_ok");
+
+    // Create the table locally.
+    catalog.createTable(from, simpleSchema());
+
+    // Even if the upstream also has the table, rename should succeed locally.
+    when(mockUpstream.tableExists(from)).thenReturn(true);
+
+    catalog.renameTable(from, to);
+
+    Assertions.assertFalse(localTableExists(from), "old name should be gone locally");
+    Assertions.assertTrue(localTableExists(to), "new name should exist locally");
+
+    // Upstream was consulted for the existence pre-check, but its renameTable was never called.
+    verify(mockUpstream, never()).renameTable(any(), any());
+  }
+
+  // ==================== Test 4: namespaceUnionListing (spec §5.3.5) ====================
+
+  /**
+   * {@code listNamespaces} returns the union of local and upstream namespaces, deduped.
+   *
+   * <p>{@code loadNamespaceMetadata} returns local properties for local namespaces, and virtual
+   * (empty) properties for upstream-only namespaces without persisting them to catalog-a.
+   */
+  @Test
+  void testNamespaceUnionListing() {
+    Namespace parent = Namespace.empty();
+
+    // Local namespace.
+    Namespace localNs = Namespace.of("ns_local_union");
+    catalog.createNamespace(localNs);
+
+    // Upstream namespace (does not exist locally).
+    Namespace upstreamNs = Namespace.of("ns_upstream_union");
+    when(mockUpstreamNs.listNamespaces(parent)).thenReturn(List.of(upstreamNs));
+    when(mockUpstreamNs.namespaceExists(upstreamNs)).thenReturn(true);
+    when(mockUpstreamNs.loadNamespaceMetadata(upstreamNs))
+        .thenReturn(Map.of("upstream-only", "true"));
+
+    // listNamespaces should return the union.
+    List<Namespace> namespaces = catalog.listNamespaces(parent);
+    Assertions.assertTrue(
+        namespaces.contains(localNs), "local namespace should be in the union: " + namespaces);
+    Assertions.assertTrue(
+        namespaces.contains(upstreamNs),
+        "upstream namespace should be in the union: " + namespaces);
+
+    // loadNamespaceMetadata for local namespace returns local properties.
+    Map<String, String> localProps = catalog.loadNamespaceMetadata(localNs);
+    Assertions.assertNotNull(localProps, "local namespace should have properties");
+
+    // loadNamespaceMetadata for upstream-only namespace returns virtual empty properties.
+    Map<String, String> upstreamProps = catalog.loadNamespaceMetadata(upstreamNs);
+    Assertions.assertTrue(
+        upstreamProps.isEmpty(),
+        "upstream-only namespace should get virtual empty properties: " + upstreamProps);
+  }
+
+  /**
+   * {@code dropNamespace} on an upstream-only namespace is rejected with {@link
+   * ForbiddenException}.
+   */
+  @Test
+  void testDropUpstreamOnlyNamespaceRejected() {
+    Namespace upstreamNs = Namespace.of("ns_upstream_drop");
+
+    // Upstream has it, local does not.
+    when(mockUpstreamNs.namespaceExists(upstreamNs)).thenReturn(true);
+
+    Assertions.assertThrows(
+        ForbiddenException.class,
+        () -> catalog.dropNamespace(upstreamNs),
+        "dropping an upstream-only namespace should be forbidden");
+
+    verify(mockUpstreamNs, never()).dropNamespace(any());
+  }
+
+  // ==================== Test 5: viewLocalOnly (spec §5.3.4) ====================
+
+  /**
+   * VIEW operations go through the local catalog only. {@link CustIcebergCatalog} inherits all
+   * {@link org.apache.iceberg.catalog.ViewCatalog} methods from {@code JdbcCatalog} without
+   * override, so views are inherently local-only — they do NOT participate in mirroring and do NOT
+   * trigger the table-level routing overrides ({@code loadTable} / {@code tableExists}).
+   *
+   * <p>This test creates a view locally, verifies {@code listViews} / {@code viewExists} see it,
+   * drops it, and verifies the upstream mock was never consulted for any table-level operation.
+   */
+  @Test
+  void testViewLocalOnly() {
+    Namespace ns = Namespace.of("ns_view");
+    TableIdentifier viewIdent = TableIdentifier.of(ns, "v_local");
+
+    // Create the namespace (views require an existing namespace).
+    catalog.createNamespace(ns);
+
+    // Create a view locally via the inherited ViewCatalog.buildView path.
+    Schema viewSchema = simpleSchema();
+    catalog
+        .buildView(viewIdent)
+        .withQuery("spark", "SELECT 1 AS id")
+        .withSchema(viewSchema)
+        .withDefaultNamespace(ns)
+        .create();
+
+    // listViews should return only the local view.
+    List<TableIdentifier> views = catalog.listViews(ns);
+    Assertions.assertTrue(
+        views.contains(viewIdent), "local view should appear in listViews: " + views);
+
+    // viewExists should confirm.
+    Assertions.assertTrue(catalog.viewExists(viewIdent), "viewExists should return true");
+
+    // Drop the view — should succeed locally.
+    Assertions.assertTrue(catalog.dropView(viewIdent), "dropView should return true");
+
+    // After drop, the view is gone.
+    Assertions.assertFalse(catalog.viewExists(viewIdent), "view should be gone after drop");
+
+    // Critical: no view operation should have triggered table-level routing overrides.
+    // The upstream was never consulted for loadTable or tableExists during view operations.
+    verify(mockUpstream, never()).loadTable(any());
+    verify(mockUpstream, never()).tableExists(any());
+  }
+
+  // ==================== Helpers ====================
+
+  /**
+   * Direct local existence probe — bypasses our overridden {@code tableExists} and {@code
+   * loadTable} (which would consult the upstream). Uses {@code metadataLocation} which reads
+   * directly from the JDBC backend; returns {@code null} for unmaterialized/non-existent tables,
+   * non-null for materialized ones.
+   */
+  private boolean localTableExists(TableIdentifier identifier) {
+    return catalog.metadataLocation(identifier) != null;
+  }
+}
