+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import org.apache.iceberg.LocationProviders;
+import org.apache.iceberg.TableMetadata;
+import org.apache.iceberg.TableOperations;
+import org.apache.iceberg.io.FileIO;
+import org.apache.iceberg.io.LocationProvider;
+
+/**
+ * A read-only {@link TableOperations} used by {@link CustIcebergCatalog#loadTable} when serving an
+ * unmaterialized mirror table.
+ *
+ * <p>Its {@link #current()} returns the catalog-b metadata with the location field rewritten by
+ * {@link CustMetadataRewriter}. {@link #io()} returns the upstream table's FileIO so that clients
+ * can plan scans and read data files (which still live in catalog-b's storage).
+ *
+ * <p>All write-side operations throw {@link UnsupportedOperationException}. First-write
+ * materialization is handled separately in {@code CustTableOperations} (PR 3); until a table is
+ * materialized, it cannot be modified via this path.
+ */
+final class CustReadOnlyTableOperations implements TableOperations {
+
+  private final TableMetadata metadata;
+  private final FileIO io;
+
+  CustReadOnlyTableOperations(TableMetadata metadata, FileIO io) {
+    this.metadata = metadata;
+    this.io = io;
+  }
+
+  @Override
+  public TableMetadata current() {
+    return metadata;
+  }
+
+  /**
+   * Returns the same metadata as {@link #current()}. This is a point-in-time snapshot of the
+   * upstream state at the moment {@link CustIcebergCatalog#loadTable} was called; we deliberately
+   * do not re-fetch from catalog-b on refresh. Clients wanting the latest upstream state should
+   * call {@code loadTable} again.
+   */
+  @Override
+  public TableMetadata refresh() {
+    return metadata;
+  }
+
+  /**
+   * Always throws; first-write materialization is handled by the commit path in PR 3.
+   *
+   * @throws UnsupportedOperationException always
+   */
+  @Override
+  public void commit(TableMetadata base, TableMetadata newMetadata) {
+    throw new UnsupportedOperationException(
+        "Commit is not supported on an unmaterialized cust mirror table; "
+            + "first-write materialization is implemented in CustTableOperations (PR 3).");
+  }
+
+  @Override
+  public FileIO io() {
+    return io;
+  }
+
+  @Override
+  public String metadataFileLocation(String fileName) {
+    // The metadata file location is derived from the rewritten table location; we compute it from
+    // the per-table metadata directory so that any caller that happens to ask sees a catalog-a
+    // path rather than the upstream catalog-b path.
+    String tableLocation = metadata.location();
+    String base = tableLocation.endsWith("/") ? tableLocation : tableLocation + "/";
+    return base + "metadata/" + fileName;
+  }
+
+  @Override
+  public LocationProvider locationProvider() {
+    return LocationProviders.locationsFor(metadata.location(), metadata.properties());
+  }
+}
