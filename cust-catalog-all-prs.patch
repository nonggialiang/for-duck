+/**
+ * Production {@link UpstreamLookup} that resolves the upstream catalog-b through the Gravitino
+ * {@link CatalogManager} (spec §5.4 / §8.7).
+ *
+ * <p>When {@code loadUpstream(catalogName)} is called (lazily, on first read of an unmaterialized
+ * mirror table), this implementation:
+ *
+ * <ol>
+ *   <li>Loads catalog-b's Gravitino {@link Catalog} via {@link CatalogManager#loadCatalog}.
+ *   <li>Extracts its properties and converts them to Iceberg configuration via {@link
+ *       IcebergPropertiesUtils#toIcebergCatalogProperties}.
+ *   <li>Creates a fresh {@link IcebergCatalogWrapper} from the resulting {@link IcebergConfig}.
+ *   <li>Returns the underlying Iceberg {@link org.apache.iceberg.catalog.Catalog} via {@code
+ *       wrapper.getCatalog()}.
+ * </ol>
+ *
+ * <p>This class is registered in {@link UpstreamLookupHolder} by {@link
+ * CustCatalogOperations#initialize} during catalog-a startup. The lookup is called lazily by {@link
+ * CustIcebergCatalog#upstream()} on the first read that falls through to the upstream, so catalog-b
+ * need not exist at catalog-a initialization time — only at first use.
+ *
+ * <p>The Iceberg {@link Catalog} returned is cached by {@link CustIcebergCatalog}'s volatile field
+ * so the wrapper creation cost is paid only once per cust catalog instance.
+ */
+public class GravitinoEnvUpstreamLookup implements UpstreamLookup {
+
+  private static final Logger LOG = LoggerFactory.getLogger(GravitinoEnvUpstreamLookup.class);
+
+  private final String metalake;
+
+  /**
+   * Creates an upstream lookup that resolves catalogs in the given metalake.
+   *
+   * @param metalake the metalake name; must not be {@code null} or empty.
+   */
+  public GravitinoEnvUpstreamLookup(String metalake) {
+    Preconditions.checkArgument(
+        metalake != null && !metalake.isEmpty(),
+        "metalake is required for GravitinoEnvUpstreamLookup");
+    this.metalake = metalake;
+  }
+
+  @Override
+  public org.apache.iceberg.catalog.Catalog loadUpstream(String catalogName) {
+    LOG.info("Loading upstream catalog '{}' from metalake '{}'", catalogName, metalake);
+
+    CatalogManager catalogManager = GravitinoEnv.getInstance().catalogManager();
+    NameIdentifier catalogIdent = NameIdentifier.of(metalake, catalogName);
+    Catalog gravitinoCatalog = catalogManager.loadCatalog(catalogIdent);
+
+    // Convert Gravitino catalog properties to Iceberg configuration.
+    Map<String, String> icebergProps =
+        IcebergPropertiesUtils.toIcebergCatalogProperties(gravitinoCatalog.properties());
+    IcebergConfig icebergConfig = new IcebergConfig(icebergProps);
+
+    // Create a wrapper and extract the Iceberg Catalog.
+    IcebergCatalogWrapper wrapper = new IcebergCatalogWrapper(icebergConfig);
+    org.apache.iceberg.catalog.Catalog icebergCatalog = wrapper.getCatalog();
+    LOG.info(
+        "Loaded upstream catalog '{}' → Iceberg Catalog {} ({})",
+        catalogName,
+        icebergCatalog.name(),
+        icebergCatalog.getClass().getSimpleName());
+    return icebergCatalog;
+  }
+}
