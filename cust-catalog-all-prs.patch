+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import org.apache.gravitino.metrics.source.MetricsSource;
+
+/**
+ * Metrics source for the cust catalog (spec §5.6 / PR 6).
+ *
+ * <p>Registers four counters that cover the core observability dimensions of the cust mirror:
+ *
+ * <ul>
+ *   <li>{@code cust.mirror.reads} — number of {@code loadTable} calls that fell through to the
+ *       upstream catalog (unmaterialized mirror reads).
+ *   <li>{@code cust.materialize.events} — number of successful first-write materializations.
+ *   <li>{@code cust.conflict.counts} — number of concurrent first-write CAS conflicts.
+ *   <li>{@code cust.upstream.fwd.reads} — number of reads forwarded to the upstream (kept separate
+ *       from mirror.reads for finer-grained diagnostics; currently mirrors mirror.reads).
+ * </ul>
+ *
+ * <p>The fully qualified metric name registered in {@link
+ * org.apache.gravitino.metrics.MetricsSystem} is {@code
+ * "gravitino-catalog.cust.<catalogName>.<counterName>"}.
+ *
+ * <p>Counter references are not stored as fields to avoid a compile-time dependency on {@code
+ * com.codahale.metrics.Counter} (the Dropwizard metrics JAR is only transitively available through
+ * {@code core}, which is {@code compileOnly}). Instead, each increment calls {@link
+ * #getCounter(String)} which returns the cached counter from the parent's {@code MetricRegistry}.
+ */
+public class CustMetricsSource extends MetricsSource {
+
+  /** Counter: unmaterialized mirror reads (loadTable fell through to upstream). */
+  public static final String MIRROR_READS = "cust.mirror.reads";
+
+  /** Counter: successful first-write materializations. */
+  public static final String MATERIALIZE_EVENTS = "cust.materialize.events";
+
+  /** Counter: concurrent first-write CAS conflicts (CommitFailedException). */
+  public static final String CONFLICT_COUNTS = "cust.conflict.counts";
+
+  /** Counter: reads forwarded to the upstream catalog. */
+  public static final String UPSTREAM_FWD_READS = "cust.upstream.fwd.reads";
+
+  /**
+   * Creates a metrics source for the given cust catalog.
+   *
+   * @param catalogName the catalog name used in the metrics source name (e.g. {@code "catalog-a"}).
+   */
+  public CustMetricsSource(String catalogName) {
+    super(MetricsSource.GRAVITINO_CATALOG_METRIC_PREFIX + ".cust." + catalogName);
+  }
+
+  /** Increments the mirror-reads counter. */
+  public void incMirrorReads() {
+    getCounter(MIRROR_READS).inc();
+  }
+
+  /** Increments the materialize-events counter. */
+  public void incMaterializeEvents() {
+    getCounter(MATERIALIZE_EVENTS).inc();
+  }
+
+  /** Increments the conflict-counts counter. */
+  public void incConflictCounts() {
+    getCounter(CONFLICT_COUNTS).inc();
+  }
+
+  /** Increments the upstream-forwarded-reads counter. */
+  public void incUpstreamFwdReads() {
+    getCounter(UPSTREAM_FWD_READS).inc();
+  }
+
+  /** Returns the current mirror-reads count. */
+  public long getMirrorReadsCount() {
+    return getCounter(MIRROR_READS).getCount();
+  }
+
+  /** Returns the current materialize-events count. */
+  public long getMaterializeEventsCount() {
+    return getCounter(MATERIALIZE_EVENTS).getCount();
+  }
+
+  /** Returns the current conflict-counts count. */
+  public long getConflictCountsCount() {
+    return getCounter(CONFLICT_COUNTS).getCount();
+  }
+
+  /** Returns the current upstream-forwarded-reads count. */
+  public long getUpstreamFwdReadsCount() {
+    return getCounter(UPSTREAM_FWD_READS).getCount();
+  }
+}
