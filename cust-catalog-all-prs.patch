+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import java.util.Map;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalog;
+import org.apache.gravitino.connector.CatalogOperations;
+import org.apache.gravitino.connector.PropertiesMetadata;
+import org.apache.gravitino.connector.capability.Capability;
+
+/**
+ * {@code cust} catalog (catalog-a) — an Iceberg REST catalog variant that mirrors an upstream
+ * Iceberg catalog (catalog-b) with copy-on-write semantics.
+ *
+ * <p>This class extends {@link IcebergCatalog} to inherit all the Iceberg-specific behavior
+ * (capability, view catalog, schema/table property metadata, credential provider wiring). It
+ * overrides:
+ *
+ * <ul>
+ *   <li>{@link #shortName()} to return {@code "cust"}, which is the provider string used by {@code
+ *       CatalogManager} to resolve this catalog via SPI.
+ *   <li>{@link #newOps(Map)} to return a {@link CustCatalogOperations}, which forces the Iceberg
+ *       backend to {@code jdbc} and (in later PRs) implements the mirror/materialize logic.
+ *   <li>{@link #catalogPropertiesMetadata()} to return a {@link CustCatalogPropertiesMetadata}
+ *       which adds the {@code upstream-catalog} property on top of the standard Iceberg catalog
+ *       properties.
+ * </ul>
+ *
+ * <p>PR 1 scope: this catalog is registered with Gravitino and initializes a JDBC-backed {@code
+ * IcebergCatalogWrapper}. Mirror/COW behaviors will be added in subsequent PRs.
+ */
+public class CustCatalog extends IcebergCatalog {
+
+  static final CustCatalogPropertiesMetadata CUST_PROPERTIES_META =
+      new CustCatalogPropertiesMetadata();
+
+  /**
+   * Returns the provider short name for this catalog, used by the SPI-based catalog resolution in
+   * {@code CatalogManager}.
+   *
+   * @return the constant string {@code "cust"}
+   */
+  @Override
+  public String shortName() {
+    return "cust";
+  }
+
+  /**
+   * Creates a new instance of {@link CustCatalogOperations} with the provided configuration.
+   *
+   * @param config the configuration map for the cust catalog operations
+   * @return a new {@link CustCatalogOperations} instance
+   */
+  @Override
+  protected CatalogOperations newOps(Map<String, String> config) {
+    return new CustCatalogOperations();
+  }
+
+  /**
+   * Returns the cust-specific catalog properties metadata, which extends the Iceberg catalog
+   * properties metadata with the {@code upstream-catalog} property.
+   *
+   * @return the cust catalog properties metadata instance
+   */
+  @Override
+  public PropertiesMetadata catalogPropertiesMetadata() throws UnsupportedOperationException {
+    return CUST_PROPERTIES_META;
+  }
+
+  /**
+   * Returns the capability descriptor for the cust catalog. The cust catalog shares the same
+   * capability surface as the Iceberg catalog.
+   *
+   * @return an {@link org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalogCapability}
+   *     instance
+   */
+  @Override
+  public Capability newCapability() {
+    return super.newCapability();
+  }
+}
