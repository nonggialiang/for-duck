+ * software distributed under the License is distributed on an
+ * "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY
+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+package org.apache.gravitino.catalog.lakehouse.cust;
+
+/**
+ * Process-wide holder for the production {@link UpstreamLookup} instance.
+ *
+ * <p>The cust catalog plugin (loaded via SPI in an isolated classloader) cannot directly reference
+ * the {@code IcebergCatalogWrapperManager} from the {@code iceberg-rest-server} module. Instead,
+ * the REST server registers its lookup implementation here during startup, and the cust plugin
+ * reads it lazily when {@link CustIcebergCatalog} is instantiated via the {@code
+ * IcebergCatalogUtil.loadCatalogBackend} path.
+ *
+ * <p>Unit tests typically bypass this holder by constructing {@link CustIcebergCatalog} directly
+ * with a mock lookup.
+ *
+ * <p>This class is thread-safe. The registered lookup is intended to be set exactly once at server
+ * startup; subsequent calls to {@link #setInstance(UpstreamLookup)} are allowed but log a warning
+ * to surface misconfiguration.
+ */
+public final class UpstreamLookupHolder {
+
+  private static volatile UpstreamLookup instance;
+
+  private UpstreamLookupHolder() {}
+
+  /**
+   * Registers the production {@link UpstreamLookup}.
+   *
+   * @param lookup the lookup to register; must not be {@code null}
+   */
+  public static void setInstance(UpstreamLookup lookup) {
+    if (lookup == null) {
+      throw new IllegalArgumentException("UpstreamLookup cannot be null");
+    }
+    instance = lookup;
+  }
+
+  /**
+   * Returns the registered {@link UpstreamLookup}.
+   *
+   * @return the registered lookup
+   * @throws IllegalStateException if no lookup has been registered
+   */
+  public static UpstreamLookup getInstance() {
+    UpstreamLookup current = instance;
+    if (current == null) {
+      throw new IllegalStateException(
+          "UpstreamLookup is not registered. The Iceberg REST Server must register one via "
+              + "UpstreamLookupHolder.setInstance(...) before serving cust catalogs.");
+    }
+    return current;
+  }
+
+  /**
+   * Returns whether a lookup has been registered. Intended for test cleanup and assertions.
+   *
+   * @return {@code true} if a lookup is currently registered
+   */
+  public static boolean isSet() {
+    return instance != null;
+  }
+
+  /** Clears the registered lookup. Intended for test isolation only. */
+  public static void clear() {
+    instance = null;
+  }
+}
