+import org.slf4j.LoggerFactory;
+
+/**
+ * The catalog-a Iceberg {@link Catalog} — a JDBC-backed catalog that also mirrors an upstream
+ * catalog-b for reads of unmaterialized tables.
+ *
+ * <p>This class extends {@link JdbcCatalogWithMetadataLocationSupport} so that:
+ *
+ * <ul>
+ *   <li>The local (catalog-a) tables are stored in the JDBC backend and benefit from row-level CAS
+ *       (spec §3).
+ *   <li>The Iceberg REST server's {@link
+ *       org.apache.gravitino.iceberg.common.cache.SupportsMetadataLocation} fast path keeps working
+ *       for materialized tables.
+ * </ul>
+ *
+ * <p>On top of the inherited JDBC behavior, this class adds three routing overrides (spec §5.1.2):
+ *
+ * <ul>
+ *   <li>{@code loadTable}: try local first; on {@link NoSuchTableException} fall through to
+ *       catalog-b, rewrite the {@code location} field of the upstream {@link TableMetadata} via
+ *       {@link CustMetadataRewriter}, and wrap the result in a {@link CustReadOnlyTableOperations}.
+ *   <li>{@code tableExists}: logical OR of local and upstream existence.
+ *   <li>{@code listTables}: union of local and upstream identifiers.
+ * </ul>
+ *
+ * <p>{@code metadataLocation} is inherited unchanged: it returns the JDBC-stored metadata location
+ * for materialized tables and {@code null} for unmaterialized ones. The {@code null} return is what
+ * tells {@code IcebergCatalogWrapper} to skip the ETag fast path and call {@code loadTable} for the
+ * full mirror semantics.
+ *
+ * <p>All write-side operations ({@code createTable}, {@code commit}, etc.) are inherited from
+ * {@link JdbcCatalog}. First-write materialization (spec §5.2) is handled by the standard Iceberg
+ * commit path combined with the JDBC CAS — implemented in PR 3.
+ *
+ * <p>Production wiring: this class is instantiated via Iceberg's {@code
+ * CatalogUtil.loadCatalog(className, ...)} from {@code IcebergCatalogUtil.loadCustCatalog}. The
+ * upstream lookup is resolved lazily from {@link UpstreamLookupHolder} on the first read.
+ */
+public class CustIcebergCatalog extends JdbcCatalogWithMetadataLocationSupport {
+
+  private static final Logger LOG = LoggerFactory.getLogger(CustIcebergCatalog.class);
+
+  /** Fully-qualified class name; mirrored here for {@code IcebergCatalogUtil.loadCustCatalog}. */
+  public static final String CLASS_NAME =
+      "org.apache.gravitino.catalog.lakehouse.cust.CustIcebergCatalog";
+
+  /**
+   * Property key for the upstream catalog name. Mirror of {@code CustCatalogPropertiesMetadata}.
+   */
+  private static final String UPSTREAM_CATALOG_KEY = "upstream-catalog";
+
+  /**
+   * Optional override of the upstream lookup. Set only by the test constructor; production
+   * instances read from {@link UpstreamLookupHolder}.
+   */
+  private final UpstreamLookup upstreamLookupOverride;
+
+  private volatile String localWarehouse;
+  private volatile String upstreamCatalogName;
+  // Lazy: initialized on first read routing.
+  private volatile Catalog upstreamCatalog;
+
+  /**
+   * No-arg constructor used by Iceberg {@code CatalogUtil.loadCatalog} reflection.
+   *
+   * <p>This is the production path: configuration (warehouse, upstream-catalog) is supplied later
+   * via {@link #initialize(String, Map)}.
+   */
+  public CustIcebergCatalog() {
+    this(null);
+  }
+
+  /**
+   * Test constructor allowing direct injection of an {@link UpstreamLookup} without going through
+   * {@link UpstreamLookupHolder}. Production code uses the no-arg constructor.
+   *
+   * @param upstreamLookupOverride the lookup to use; may be {@code null} to defer to the holder.
+   */
+  CustIcebergCatalog(UpstreamLookup upstreamLookupOverride) {
+    super(true);
+    this.upstreamLookupOverride = upstreamLookupOverride;
+  }
+
+  @Override
+  public void initialize(String name, Map<String, String> properties) {
+    super.initialize(name, properties);
+    this.localWarehouse = properties.get(IcebergConstants.WAREHOUSE);
+    this.upstreamCatalogName = properties.get(UPSTREAM_CATALOG_KEY);
+    Preconditions.checkArgument(
+        upstreamCatalogName != null && !upstreamCatalogName.isEmpty(),
+        "cust catalog requires the '%s' property",
+        UPSTREAM_CATALOG_KEY);
+    Preconditions.checkArgument(
+        localWarehouse != null && !localWarehouse.isEmpty(),
+        "cust catalog requires the '%s' property",
+        IcebergConstants.WAREHOUSE);
+    LOG.info(
+        "Initialized cust catalog '{}' with warehouse={} upstream-catalog={}",
+        name,
+        localWarehouse,
+        upstreamCatalogName);
+  }
+
+  /**
+   * Loads a table from catalog-a.
+   *
+   * <p>If the table is materialized locally (exists in JDBC), returns the standard local table. If
+   * not, falls through to catalog-b, rewrites the upstream metadata's location, and returns a
+   * read-only mirror via {@link CustReadOnlyTableOperations}.
+   *
+   * @throws NoSuchTableException if the table exists neither in catalog-a nor catalog-b
+   */
+  @Override
+  public Table loadTable(TableIdentifier identifier) {
+    try {
+      return super.loadTable(identifier);
+    } catch (NoSuchTableException localMissing) {
+      return loadUpstreamAndRewrite(identifier);
+    }
+  }
+
+  /**
+   * Returns true if the table exists in either catalog-a (materialized) or catalog-b (upstream
+   * mirror).
+   *
+   * <p>We deliberately do NOT call {@code super.tableExists(identifier)}: in Iceberg 1.11, {@code
+   * JdbcCatalog} does not override {@code tableExists}, so {@code super.tableExists} would resolve
+   * to the {@code Catalog} interface default, which polymorphically calls {@code loadTable} —
+   * routing the request through our mirror override and triggering a needless upstream fetch. We
+   * probe the local side directly via {@code super.loadTable} inside a try/catch instead.
+   */
+  @Override
+  public boolean tableExists(TableIdentifier identifier) {
+    if (localTableExists(identifier)) {
+      return true;
+    }
+    return upstream().tableExists(identifier);
+  }
+
+  /** Direct local existence probe — bypasses the polymorphic default {@code tableExists}. */
+  private boolean localTableExists(TableIdentifier identifier) {
+    try {
+      super.loadTable(identifier);
+      return true;
+    } catch (NoSuchTableException e) {
+      return false;
+    }
+  }
+
+  /**
+   * Lists tables from both catalog-a and catalog-b under the given namespace. Identifiers present
+   * in both are returned once.
+   */
+  @Override
+  public List<TableIdentifier> listTables(Namespace namespace) {
+    List<TableIdentifier> local = safeList(super::listTables, namespace);
+    List<TableIdentifier> remote = safeList(upstream()::listTables, namespace);
+    Set<TableIdentifier> merged = Sets.newLinkedHashSet();
+    merged.addAll(local);
+    merged.addAll(remote);
+    return ImmutableList.copyOf(merged);
+  }
+
+  /**
+   * Loads the upstream table, rewrites its location, and wraps the metadata in a read-only
+   * operations object.
+   *
+   * <p>If the upstream lookup itself throws {@link NoSuchTableException}, it propagates so callers
+   * see a single, consistent error from {@link #loadTable}.
+   *
+   * <p>The upstream {@link Table} is assumed to be a {@link BaseTable} (the standard Iceberg
+   * implementation returned by JdbcCatalog, HiveCatalog, MemoryCatalog, and RESTCatalog). The
+   * {@link Table} interface itself does not expose {@code operations()}; the cast is required to
+   * reach the underlying {@link TableMetadata}.
+   */
+  private Table loadUpstreamAndRewrite(TableIdentifier identifier) {
+    Table upstreamTable = upstream().loadTable(identifier);
+    Preconditions.checkArgument(
+        upstreamTable instanceof BaseTable,
+        "Upstream catalog returned non-BaseTable implementation (%s); cust mirror is unsupported "
+            + "for this upstream catalog type",
+        upstreamTable.getClass().getName());
+    TableMetadata upstreamMetadata = ((BaseTable) upstreamTable).operations().current();
+    FileIO upstreamIo = upstreamTable.io();
+    TableMetadata rewritten =
+        CustMetadataRewriter.rewriteLocation(upstreamMetadata, localWarehouse, identifier);
+    String displayName = identifier.toString();
+    return new BaseTable(new CustReadOnlyTableOperations(rewritten, upstreamIo), displayName);
+  }
+
+  /**
+   * Returns the upstream catalog, lazily resolving it via the configured {@link UpstreamLookup}.
+   */
+  private Catalog upstream() {
+    Catalog snapshot = upstreamCatalog;
+    if (snapshot != null) {
+      return snapshot;
+    }
+    synchronized (this) {
+      if (upstreamCatalog == null) {
+        UpstreamLookup lookup =
+            upstreamLookupOverride != null
+                ? upstreamLookupOverride
+                : UpstreamLookupHolder.getInstance();
+        upstreamCatalog = lookup.loadUpstream(upstreamCatalogName);
+      }
+      return upstreamCatalog;
+    }
+  }
+
+  /**
+   * Calls a namespace-scoped listing, swallowing {@link NoSuchNamespaceException} and returning an
+   * empty list instead. Used by {@link #listTables(Namespace)} so that an absence of the namespace
+   * on either side does not abort the union.
+   */
+  private static List<TableIdentifier> safeList(NamespaceListing fn, Namespace namespace) {
+    try {
+      return fn.apply(namespace);
+    } catch (NoSuchNamespaceException e) {
+      return Collections.emptyList();
+    }
+  }
+
+  /**
+   * Internal functional interface for {@link #safeList} — avoids {@code java.util.function} clash.
+   */
+  @FunctionalInterface
+  private interface NamespaceListing {
+    List<TableIdentifier> apply(Namespace namespace);
+  }
+}
