+ * specific language governing permissions and limitations
+ * under the License.
+ */
+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import com.google.common.base.Preconditions;
+import com.google.common.collect.ImmutableMap;
+import java.util.Map;
+import org.apache.iceberg.TableMetadata;
+import org.apache.iceberg.catalog.TableIdentifier;
+
+/**
+ * Rewrites the {@code location} field of an upstream {@link TableMetadata} so that clients see the
+ * catalog-a path while keeping the manifest / data-file paths (which are absolute URIs inside
+ * snapshots) pointing at catalog-b.
+ *
+ * <p>Per spec §5.1.2, when serving a read of an unmaterialized mirror table:
+ *
+ * <ul>
+ *   <li>The top-level {@code metadata.location} is rewritten to {@code <catalog-a-warehouse>/<ns>}
+ *       ... {@code /<table>}.
+ *   <li>The {@code manifest-list}, {@code manifest}, and data-file paths inside each snapshot stay
+ *       unchanged — they continue to point at catalog-b's warehouse. Reads of those files rely on
+ *       the deployment precondition that catalog-a clients can read catalog-b (spec §1).
+ *   <li>Properties with hardcoded path values (e.g. {@code write.metadata.path}) are rewritten to
+ *       keep future writes consistent with the catalog-a warehouse.
+ * </ul>
+ *
+ * <p>The returned metadata is a fresh immutable copy; the input is left untouched.
+ */
+public final class CustMetadataRewriter {
+
+  private CustMetadataRewriter() {}
+
+  /**
+   * Produces a new {@link TableMetadata} with the {@code location} field rewritten to the catalog-a
+   * warehouse. Manifest paths inside snapshots are preserved.
+   *
+   * @param upstream the original metadata loaded from catalog-b
+   * @param localWarehouse the catalog-a warehouse root (e.g. {@code s3://bucket/catalog-a})
+   * @param identifier the table identifier, used to derive the per-table location
+   * @return a new immutable metadata with rewritten location and path-style properties
+   */
+  public static TableMetadata rewriteLocation(
+      TableMetadata upstream, String localWarehouse, TableIdentifier identifier) {
+    Preconditions.checkArgument(upstream != null, "upstream metadata is null");
+    Preconditions.checkArgument(localWarehouse != null, "localWarehouse is null");
+    Preconditions.checkArgument(identifier != null, "identifier is null");
+
+    String newLocation = computeLocalLocation(localWarehouse, identifier);
+
+    TableMetadata.Builder builder = TableMetadata.buildFrom(upstream);
+    builder.setLocation(newLocation);
+    builder.setProperties(
+        rewritePathStyleProperties(upstream.properties(), localWarehouse, identifier));
+
+    return builder.build();
+  }
+
+  /**
+   * Computes the canonical catalog-a location for a table: {@code <warehouse>/<ns1>/<ns2>/...
+   * /<table>}.
+   *
+   * <p>The namespace levels are joined with {@code "/"}; this matches how Iceberg's {@code
+   * LocationProvider} typically lays out tables under a warehouse root.
+   */
+  static String computeLocalLocation(String warehouse, TableIdentifier identifier) {
+    StringBuilder sb = new StringBuilder(warehouse);
+    if (!warehouse.endsWith("/")) {
+      sb.append('/');
+    }
+    for (String level : identifier.namespace().levels()) {
+      sb.append(level).append('/');
+    }
+    sb.append(identifier.name());
+    return sb.toString();
+  }
+
+  /**
+   * Returns the subset of upstream properties whose values look like paths anchored at the upstream
+   * warehouse, rewritten to the equivalent catalog-a paths.
+   *
+   * <p>For PR 2 we conservatively rewrite only well-known path-style properties: {@code
+   * write.metadata.path} and {@code write.data.path}. Other properties are left as-is. Future PRs
+   * may expand this list.
+   */
+  static Map<String, String> rewritePathStyleProperties(
+      Map<String, String> upstreamProperties, String localWarehouse, TableIdentifier identifier) {
+    String perTableMetadataPath = computeLocalLocation(localWarehouse, identifier) + "/metadata";
+    String perTableDataPath = computeLocalLocation(localWarehouse, identifier) + "/data";
+
+    ImmutableMap.Builder<String, String> rewritten = ImmutableMap.builder();
+    if (upstreamProperties.containsKey("write.metadata.path")) {
+      rewritten.put("write.metadata.path", perTableMetadataPath);
+    }
+    if (upstreamProperties.containsKey("write.data.path")) {
+      rewritten.put("write.data.path", perTableDataPath);
+    }
+    return rewritten.build();
+  }
+}
