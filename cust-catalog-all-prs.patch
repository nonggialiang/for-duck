+  private Map<String, String> baseProps() {
+    Map<String, String> p = new HashMap<>();
+    p.put(CatalogProperties.WAREHOUSE_LOCATION, localWarehouse);
+    p.put(CatalogProperties.URI, "jdbc:sqlite::memory:");
+    p.put(IcebergConstants.GRAVITINO_JDBC_DRIVER, "org.sqlite.JDBC");
+    p.put("upstream-catalog", UPSTREAM_CATALOG_NAME);
+    p.put(IcebergConstants.ICEBERG_JDBC_SCHEMA_VERSION, "V1");
+    // Non-strict mode simplifies test setup — auto-creates namespaces so we can exercise
+    // load routing without an explicit createNamespace step on the local side.
+    p.put(IcebergConstants.ICEBERG_JDBC_STRICT_MODE, "false");
+    return p;
+  }
+
+  private static Schema simpleSchema() {
+    return new Schema(List.of(NestedField.optional(1, "id", Types.LongType.get())));
+  }
+
+  /**
+   * Materialized table: created locally, {@code loadTable} should return the local Table without
+   * touching the upstream.
+   */
+  @Test
+  void testLoadTableMaterializedReturnsLocal() {
+    Namespace ns = Namespace.of("ns_local");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_local");
+    catalog.createTable(ident, simpleSchema());
+
+    Table loaded = catalog.loadTable(ident);
+    Assertions.assertNotNull(loaded);
+    Assertions.assertTrue(
+        loaded.location().startsWith(localWarehouse),
+        "materialized table location should be local, got: " + loaded.location());
+
+    // Upstream must NOT have been consulted.
+    verify(mockUpstream, never()).loadTable(any());
+  }
+
+  /**
+   * Unmaterialized table: not present locally, exists in upstream; {@code loadTable} should return
+   * a {@link CustReadOnlyTableOperations}-backed table whose location is rewritten to the local
+   * warehouse.
+   */
+  @Test
+  void testLoadTableUnmaterializedReturnsRewrittenMirror() {
+    Namespace ns = Namespace.of("ns_remote");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_remote");
+
+    Table upstreamTable = mockUpstreamTable(ident);
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    Table loaded = catalog.loadTable(ident);
+    Assertions.assertNotNull(loaded);
+    Assertions.assertTrue(
+        loaded instanceof BaseTable,
+        "expected BaseTable so we can inspect the underlying operations");
+    Assertions.assertTrue(
+        ((BaseTable) loaded).operations() instanceof CustReadOnlyTableOperations,
+        "expected CustReadOnlyTableOperations for unmaterialized mirror");
+
+    String rewrittenLocation = loaded.location();
+    Assertions.assertTrue(
+        rewrittenLocation.startsWith(localWarehouse),
+        "rewritten location should be under local warehouse, got: " + rewrittenLocation);
+    Assertions.assertFalse(
+        rewrittenLocation.contains(UPSTREAM_WAREHOUSE),
+        "rewritten location must not contain the upstream warehouse URI");
+  }
+
+  /**
+   * Missing everywhere: not in local, not in upstream; {@code loadTable} should throw {@link
+   * NoSuchTableException}.
+   */
+  @Test
+  void testLoadTableNotFoundAnywhere() {
+    Namespace ns = Namespace.of("ns_missing");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_missing");
+    when(mockUpstream.loadTable(ident)).thenThrow(new NoSuchTableException("missing"));
+
+    Assertions.assertThrows(NoSuchTableException.class, () -> catalog.loadTable(ident));
+  }
+
+  /** {@code tableExists} returns true when only upstream has the table. */
+  @Test
+  void testTableExistsWhenUpstreamOnly() {
+    Namespace ns = Namespace.of("ns_check");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_check");
+    when(mockUpstream.tableExists(ident)).thenReturn(true);
+
+    Assertions.assertTrue(catalog.tableExists(ident));
+    verify(mockUpstream).tableExists(ident);
+  }
+
+  /** {@code tableExists} short-circuits to true when local has the table (no upstream call). */
+  @Test
+  void testTableExistsWhenLocalOnlySkipsUpstream() {
+    Namespace ns = Namespace.of("ns_local_check");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_local_check");
+    catalog.createTable(ident, simpleSchema());
+
+    Assertions.assertTrue(catalog.tableExists(ident));
+    // Upstream should not have been asked at all.
+    verify(mockUpstream, never()).tableExists(any());
+  }
+
+  /** {@code tableExists} returns false when neither side has the table. */
+  @Test
+  void testTableExistsFalseWhenNeither() {
+    TableIdentifier ident = TableIdentifier.of(Namespace.of("ns_neither"), "tbl_neither");
+    when(mockUpstream.tableExists(ident)).thenReturn(false);
+    Assertions.assertFalse(catalog.tableExists(ident));
+  }
+
+  /** {@code listTables} returns the union of local and upstream identifiers. */
+  @Test
+  void testListTablesReturnsUnion() {
+    Namespace ns = Namespace.of("ns_union");
+    catalog.createTable(TableIdentifier.of(ns, "tbl_in_local"), simpleSchema());
+
+    TableIdentifier upstreamIdent = TableIdentifier.of(ns, "tbl_in_upstream");
+    when(mockUpstream.listTables(ns)).thenReturn(List.of(upstreamIdent));
