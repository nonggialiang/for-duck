+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import com.google.common.collect.ImmutableMap;
+import java.util.Map;
+import org.apache.gravitino.NameIdentifier;
+import org.apache.gravitino.listener.api.event.Event;
+import org.apache.gravitino.listener.api.event.EventSource;
+import org.apache.gravitino.utils.PrincipalUtils;
+import org.apache.iceberg.catalog.Namespace;
+import org.apache.iceberg.catalog.TableIdentifier;
+
+/**
+ * Abstract base for all cust catalog events (spec §5.6 / PR 6).
+ *
+ * <p>Provides:
+ *
+ * <ul>
+ *   <li>Automatic user resolution via {@link PrincipalUtils#getCurrentUserName()} (falls back to
+ *       {@code "iceberg-rest"} when no principal is set — e.g. in unit tests).
+ *   <li>Conversion from Iceberg {@link TableIdentifier} to Gravitino {@link NameIdentifier} by
+ *       prepending the catalog name as the first component.
+ *   <li>A {@link #customInfo()} map carrying the catalog name and Iceberg identifier string so
+ *       audit listeners can access cust-specific context without loading the cust event subclasses
+ *       (important under classloader isolation).
+ *   <li>{@link EventSource#GRAVITINO_ICEBERG_REST_SERVER} as the event source.
+ * </ul>
+ */
+abstract class CustEvent extends Event {
+
+  private static final String ICEBERG_REST_USER_FALLBACK = "iceberg-rest";
+
+  private final String catalogName;
+  private final String icebergTableIdentifier;
+
+  /**
+   * Constructs a cust event.
+   *
+   * @param catalogName the cust catalog name (e.g. {@code "catalog-a"}).
+   * @param identifier the Iceberg table identifier.
+   */
+  CustEvent(String catalogName, TableIdentifier identifier) {
+    super(resolveUser(), toNameIdentifier(catalogName, identifier));
+    this.catalogName = catalogName;
+    this.icebergTableIdentifier = identifier.toString();
+  }
+
+  /** Returns the cust catalog name. */
+  public String catalogName() {
+    return catalogName;
+  }
+
+  /** Returns the Iceberg table identifier as a string (e.g. {@code "ns.tbl"}). */
+  public String icebergTableIdentifier() {
+    return icebergTableIdentifier;
+  }
+
+  @Override
+  public EventSource eventSource() {
+    return EventSource.GRAVITINO_ICEBERG_REST_SERVER;
+  }
+
+  @Override
+  public Map<String, String> customInfo() {
+    return ImmutableMap.of(
+        "catalog-type", "cust",
+        "catalog-name", catalogName,
+        "iceberg-table", icebergTableIdentifier);
+  }
+
+  /**
+   * Converts an Iceberg {@link TableIdentifier} to a Gravitino {@link NameIdentifier} by prepending
+   * the catalog name.
+   *
+   * <p>For example, {@code toNameIdentifier("catalog-a", TableIdentifier.of(Namespace.of("ns"),
+   * "tbl"))} produces {@code NameIdentifier.of("catalog-a", "ns", "tbl")}.
+   */
+  static NameIdentifier toNameIdentifier(String catalogName, TableIdentifier ident) {
+    Namespace ns = ident.namespace();
+    String[] parts = new String[1 + ns.levels().length + 1];
+    parts[0] = catalogName;
+    for (int i = 0; i < ns.levels().length; i++) {
+      parts[1 + i] = ns.level(i);
+    }
+    parts[parts.length - 1] = ident.name();
+    return NameIdentifier.of(parts);
+  }
+
+  private static String resolveUser() {
+    try {
+      String user = PrincipalUtils.getCurrentUserName();
+      return user != null ? user : ICEBERG_REST_USER_FALLBACK;
+    } catch (Throwable t) {
+      // In test contexts PrincipalUtils may not be initialized.
+      return ICEBERG_REST_USER_FALLBACK;
+    }
+  }
+}
