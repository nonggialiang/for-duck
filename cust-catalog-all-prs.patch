+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import com.google.common.collect.Maps;
+import java.time.Instant;
+import java.util.Map;
+import java.util.ServiceLoader;
+import java.util.stream.StreamSupport;
+import org.apache.gravitino.Catalog;
+import org.apache.gravitino.CatalogProvider;
+import org.apache.gravitino.Namespace;
+import org.apache.gravitino.connector.PropertiesMetadata;
+import org.apache.gravitino.meta.AuditInfo;
+import org.apache.gravitino.meta.CatalogEntity;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for {@link CustCatalog}.
+ *
+ * <p>Validates the catalog's SPI registration (the contract used by {@code CatalogManager}) and the
+ * basic configuration surface: provider short name, operations class binding, and properties
+ * metadata wiring.
+ */
+public class TestCustCatalog {
+
+  @Test
+  void testShortNameReturnsCust() {
+    Assertions.assertEquals("cust", new CustCatalog().shortName());
+  }
+
+  /**
+   * Validates that the cust provider is discoverable through Java's {@link ServiceLoader} SPI
+   * mechanism, which is exactly how {@code CatalogManager.lookupCatalogProvider} resolves catalog
+   * providers at runtime.
+   */
+  @Test
+  void testSPIResolutionFindsCustProvider() {
+    ServiceLoader<CatalogProvider> loader = ServiceLoader.load(CatalogProvider.class);
+    boolean found =
+        StreamSupport.stream(loader.spliterator(), false)
+            .anyMatch(p -> "cust".equals(p.shortName()) && p instanceof CustCatalog);
+    Assertions.assertTrue(
+        found,
+        "SPI file META-INF/services/org.apache.gravitino.CatalogProvider must register "
+            + "CustCatalog so that CatalogManager can resolve provider='cust'");
+  }
+
+  @Test
+  void testNewOpsReturnsCustCatalogOperations() {
+    AuditInfo auditInfo =
+        AuditInfo.builder().withCreator("creator").withCreateTime(Instant.now()).build();
+    CatalogEntity entity =
+        CatalogEntity.builder()
+            .withId(1L)
+            .withName("cust-a")
+            .withNamespace(Namespace.of("metalake"))
+            .withType(Catalog.Type.RELATIONAL)
+            .withProvider("cust")
+            .withAuditInfo(auditInfo)
+            .build();
+
+    Map<String, String> conf = Maps.newHashMap();
+    // Note: we intentionally do NOT initialize the catalog here — that requires a working JDBC
+    // connection and is covered by TestCustCatalogOperations. We only validate that the builder
+    // chain produces a CustCatalog instance with the right provider name.
+    // BaseCatalog<IcebergCatalog>#withCatalogConf returns IcebergCatalog (the type-parameter
+    // bound), so even though we constructed a CustCatalog the declared return type is the parent.
+    org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalog catalog =
+        new CustCatalog().withCatalogConf(conf).withCatalogEntity(entity);
+    Assertions.assertTrue(catalog instanceof CustCatalog, "expected CustCatalog instance");
+    Assertions.assertEquals("cust", catalog.provider());
+  }
+
+  @Test
+  void testCatalogPropertiesMetadataReturnsCustInstance() {
+    CustCatalog catalog = new CustCatalog();
+    PropertiesMetadata metadata = catalog.catalogPropertiesMetadata();
+    Assertions.assertTrue(
+        metadata instanceof CustCatalogPropertiesMetadata,
+        "CustCatalog#catalogPropertiesMetadata must return a CustCatalogPropertiesMetadata");
+    Assertions.assertTrue(
+        metadata.containsProperty(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG));
+  }
+}
