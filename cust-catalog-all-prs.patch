+import org.apache.iceberg.types.Types.NestedField;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.io.TempDir;
+
+/**
+ * Unit tests for first-write materialization (spec §5.2.1) via {@link CustTableOperations}.
+ *
+ * <p>These tests verify the end-to-end commit path:
+ *
+ * <ol>
+ *   <li>{@code firstMaterialize}: load an unmaterialized mirror, then call commit on the returned
+ *       {@link CustTableOperations}; the local JdbcCatalog should end up with a new row for this
+ *       table whose metadata is the committed {@code newMetadata}.
+ *   <li>{@code materializedThenUpdate}: after first materialization, subsequent commits take the
+ *       standard JdbcCatalog path (via {@code super.loadTable}) and do not consult the upstream.
+ * </ol>
+ *
+ * <p>The upstream is a Mockito mock so we can run without a real catalog-b. The local side is a
+ * real SQLite-backed JdbcCatalog via {@link CustIcebergCatalog}.
+ */
+public class TestCustCommit {
+
+  private static final String UPSTREAM_CATALOG_NAME = "catalog-b";
+  private static final String UPSTREAM_WAREHOUSE = "s3://bucket-b/warehouse";
+
+  @TempDir File tempDir;
+
+  private CustIcebergCatalog catalog;
+  private org.apache.iceberg.catalog.Catalog mockUpstream;
+  private UpstreamLookup mockLookup;
+
+  private String localWarehouse;
+
+  @BeforeEach
+  void setUp() {
+    mockUpstream = mock(org.apache.iceberg.catalog.Catalog.class);
+    mockLookup = name -> mockUpstream;
+    localWarehouse = tempDir.toPath().resolve("warehouse").toString();
+    catalog = new CustIcebergCatalog(mockLookup);
+    catalog.setConf(new org.apache.hadoop.hdfs.HdfsConfiguration());
+    catalog.initialize("cust-a", baseProps());
+  }
+
+  @AfterEach
+  void tearDown() {
+    if (catalog != null) {
+      try {
+        catalog.close();
+      } catch (Exception ignored) {
+        // Best-effort cleanup.
+      }
+    }
+  }
+
+  private Map<String, String> baseProps() {
+    Map<String, String> p = new HashMap<>();
+    p.put(CatalogProperties.WAREHOUSE_LOCATION, localWarehouse);
+    p.put(CatalogProperties.URI, "jdbc:sqlite::memory:");
+    p.put(IcebergConstants.GRAVITINO_JDBC_DRIVER, "org.sqlite.JDBC");
+    p.put("upstream-catalog", UPSTREAM_CATALOG_NAME);
+    p.put(IcebergConstants.ICEBERG_JDBC_SCHEMA_VERSION, "V1");
+    p.put(IcebergConstants.ICEBERG_JDBC_STRICT_MODE, "false");
+    return p;
+  }
+
+  private static Schema simpleSchema() {
+    return new Schema(List.of(NestedField.optional(1, "id", Types.LongType.get())));
+  }
+
+  /** Builds a TableMetadata that simulates what an upstream catalog-b would return. */
+  private static TableMetadata buildUpstreamMetadata(TableIdentifier ident) {
+    Schema schema = simpleSchema();
+    return TableMetadata.newTableMetadata(
+        schema,
+        PartitionSpec.unpartitioned(),
+        SortOrder.unsorted(),
+        UPSTREAM_WAREHOUSE + "/" + ident.namespace().toString() + "/" + ident.name(),
+        Collections.emptyMap());
+  }
+
+  /** Wraps an upstream TableMetadata in a BaseTable so {@link CustIcebergCatalog} can read it. */
+  private Table mockUpstreamTable(TableIdentifier ident, TableMetadata upstreamMeta) {
+    FileIO mockIo = mock(FileIO.class);
+    TableOperations mockOps = mock(TableOperations.class);
+    when(mockOps.current()).thenReturn(upstreamMeta);
+    when(mockOps.io()).thenReturn(mockIo);
+    return new BaseTable(mockOps, "upstream." + ident.name());
+  }
+
+  /**
+   * Casts a {@link Table} to {@link BaseTable} and returns its {@link TableOperations}. The {@link
+   * Table} interface doesn't expose {@code operations()}; the cast is required to reach the
+   * underlying ops.
+   */
+  private static TableOperations ops(Table table) {
+    Assertions.assertTrue(
+        table instanceof BaseTable, "expected BaseTable, got " + table.getClass());
+    return ((BaseTable) table).operations();
+  }
+
+  /**
+   * First-write materialization (spec §5.2.1): after the client commits on a {@link
+   * CustTableOperations}, the local JdbcCatalog must contain the table and its metadata location
+   * must be the one built from {@code newMetadata}, not the upstream URI.
+   */
+  @Test
+  void testFirstMaterialize() {
+    Namespace ns = Namespace.of("ns_mat");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_mat");
+
+    // Upstream has the table. (Build the mock table first, then stub loadTable — Mockito does
+    // not allow stubbing nested inside another when().thenReturn().)
+    TableMetadata upstreamMeta = buildUpstreamMetadata(ident);
+    Table upstreamTable = mockUpstreamTable(ident, upstreamMeta);
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    // Client loads the unmaterialized mirror.
+    Table loaded = catalog.loadTable(ident);
+    Assertions.assertTrue(
+        ops(loaded) instanceof CustTableOperations,
+        "precondition: loadTable should return CustTableOperations for unmaterialized table");
+    TableMetadata localBase = ops(loaded).current();
+    Assertions.assertTrue(
+        localBase.location().startsWith(localWarehouse),
+        "precondition: localBase location should be rewritten to local warehouse");
+
+    // Client appends: build a new metadata derived from localBase with a small change so commit
+    // has work to do. We add a property to differentiate newMetadata from localBase.
+    Map<String, String> newProps = new HashMap<>(localBase.properties());
+    newProps.put("cust.materialized", "true");
+    TableMetadata newMetadata = TableMetadata.buildFrom(localBase).setProperties(newProps).build();
+
+    // Commit through CustTableOperations.
+    ops(loaded).commit(localBase, newMetadata);
+
+    // After commit, the table must exist in the local JdbcCatalog.
+    Assertions.assertTrue(
+        catalog.tableExists(ident), "table should be materialized in local JDBC after commit");
+
+    // Reloading should go through the materialized branch (super.loadTable), not consult upstream.
+    Table reloaded = catalog.loadTable(ident);
+    Assertions.assertFalse(
+        ops(reloaded) instanceof CustTableOperations,
+        "after materialization, loadTable should return standard JdbcTableOperations");
+
+    // The persisted metadata must match the committed newMetadata's location (catalog-a side).
+    String persistedLocation = ops(reloaded).current().location();
+    Assertions.assertTrue(
+        persistedLocation.startsWith(localWarehouse),
+        "persisted location should be under local warehouse, got: " + persistedLocation);
+    Assertions.assertFalse(
+        persistedLocation.contains(UPSTREAM_WAREHOUSE),
+        "persisted location must not contain the upstream warehouse URI");
+    Assertions.assertEquals(
+        "true",
+        ops(reloaded).current().property("cust.materialized", null),
+        "persisted metadata should carry the property set in the commit");
+  }
+
+  /**
+   * After first materialization, a second commit should go through the standard JdbcCatalog path
+   * and must NOT consult the upstream.
+   */
+  @Test
+  void testMaterializedThenUpdate() {
+    Namespace ns = Namespace.of("ns_re");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_re");
+
+    // 1. Initial first-write materialization.
+    TableMetadata upstreamMeta = buildUpstreamMetadata(ident);
+    Table upstreamTable = mockUpstreamTable(ident, upstreamMeta);
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    Table unmaterialized = catalog.loadTable(ident);
+    TableMetadata localBase = ops(unmaterialized).current();
+    Map<String, String> v1Props = new HashMap<>(localBase.properties());
+    v1Props.put("cust.version", "v1");
+    TableMetadata v1 = TableMetadata.buildFrom(localBase).setProperties(v1Props).build();
+    ops(unmaterialized).commit(localBase, v1);
+
+    Assertions.assertTrue(catalog.tableExists(ident), "precondition: materialized");
+
+    // Reset the upstream mock's invocation recorder so we can assert it is NOT touched below.
+    org.mockito.Mockito.reset(mockUpstream);
+    when(mockUpstream.listTables(org.mockito.ArgumentMatchers.any())).thenReturn(List.of());
+
+    // 2. Reload — now goes through standard materialized path.
+    Table materialized = catalog.loadTable(ident);
+    Assertions.assertFalse(
+        ops(materialized) instanceof CustTableOperations,
+        "reload should return standard ops, not CustTableOperations");
+
+    // 3. Second commit on the materialized table.
+    TableMetadata current = ops(materialized).current();
+    Map<String, String> v2Props = new HashMap<>(current.properties());
+    v2Props.put("cust.version", "v2");
+    TableMetadata v2 = TableMetadata.buildFrom(current).setProperties(v2Props).build();
+    ops(materialized).commit(current, v2);
+
+    // 4. Verify upstream was never consulted for the second commit.
+    verify(mockUpstream, never()).loadTable(org.mockito.ArgumentMatchers.any());
+
+    // 5. Reload and verify the second commit landed.
+    Table afterV2 = catalog.loadTable(ident);
+    Assertions.assertEquals(
+        "v2",
+        ops(afterV2).current().property("cust.version", null),
+        "second commit should have updated the property");
+  }
+}
