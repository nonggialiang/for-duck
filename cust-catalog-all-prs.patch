+   * allowed because the catalog-a side has nothing to rename. If it exists neither locally nor
+   * upstream, {@link NoSuchTableException} propagates.
+   */
+  @Override
+  public void renameTable(TableIdentifier from, TableIdentifier to) {
+    if (!localTableExists(from)) {
+      if (upstream().tableExists(from)) {
+        throw new ForbiddenException(
+            "Cannot rename unmaterialized mirror table '%s': it has no local entry in catalog-a "
+                + "(rename on a mirror of catalog-b's table is not allowed). Materialize it first "
+                + "via the first-write path.",
+            from);
+      }
+      // Neither side has it — let super.renameTable throw the standard NoSuchTableException.
+    }
