+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import com.google.common.base.Preconditions;
+import com.google.common.collect.Maps;
+import java.util.Map;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalogBackend;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalogOperations;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergConstants;
+import org.apache.gravitino.connector.CatalogInfo;
+import org.apache.gravitino.connector.HasPropertyMetadata;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Operations for the {@code cust} catalog (catalog-a).
+ *
+ * <p>This class extends {@link IcebergCatalogOperations} and reuses its full surface for table /
+ * schema / view operations. It only overrides {@link #initialize} to:
+ *
+ * <ul>
+ *   <li>Validate the required {@code upstream-catalog} property (catalog-b name) is present.
+ *   <li>Force the underlying Iceberg {@code catalog-backend} to {@link IcebergCatalogBackend#JDBC
+ *       JDBC}, so catalog-a gets a CAS-providing metadata backend regardless of what the caller
+ *       specified.
+ * </ul>
+ *
+ * <p>PR 1 scope: the mirror/COW logic (reading from catalog-b, location rewriting, first-write
+ * materialization) is intentionally NOT implemented yet — at this stage the catalog behaves like a
+ * plain JDBC-backed Iceberg catalog. Mirror behaviors will be layered in by subsequent PRs.
+ */
+public class CustCatalogOperations extends IcebergCatalogOperations {
+
+  private static final Logger LOG = LoggerFactory.getLogger(CustCatalogOperations.class);
+
+  /**
+   * Initializes the cust catalog operations.
+   *
+   * <p>This method:
+   *
+   * <ol>
+   *   <li>Validates that {@code upstream-catalog} is present in {@code conf}. The value itself is
+   *       only used by later PRs that wire the upstream lookup; for PR 1 we just check its presence
+   *       so configuration errors surface early.
+   *   <li>Builds a defensive copy of {@code conf} with {@code catalog-backend} forced to {@code
+   *       jdbc}.
+   *   <li>Delegates to {@link IcebergCatalogOperations#initialize} for the standard initialization
+   *       (creates the {@link org.apache.gravitino.iceberg.common.ops.IcebergCatalogWrapper
+   *       IcebergCatalogWrapper} backed by JdbcCatalog, sets up view operations, etc.).
+   * </ol>
+   *
+   * @param conf the raw configuration map for the cust catalog
+   * @param info the catalog info associated with this operations instance
+   * @param propertiesMetadata the property metadata resolver (must return a {@link
+   *     CustCatalogPropertiesMetadata} for catalog-level properties)
+   * @throws RuntimeException if initialization fails
+   */
+  @Override
+  public void initialize(
+      Map<String, String> conf, CatalogInfo info, HasPropertyMetadata propertiesMetadata)
+      throws RuntimeException {
+    Preconditions.checkArgument(conf != null, "cust catalog configuration is null");
+
+    // Validate upstream-catalog is set. The actual lookup of the upstream wrapper happens in
+    // subsequent PRs; here we only require the configuration to be present so users get a clear
+    // error before any JDBC connection is opened.
+    String upstreamCatalog = CustCatalogPropertiesMetadata.readUpstreamCatalog(conf);
+    LOG.info(
+        "Initializing cust catalog {} with upstream-catalog = {}",
+        info != null ? info.name() : "<unknown>",
+        upstreamCatalog);
+
+    // Force catalog-backend=JDBC. Spec §3 mandates that catalog-a uses JdbcCatalog as its metadata
+    // backend so that we inherit the row-level CAS required by spec §5.2.2 for concurrent first
+    // materialization. Any caller-supplied value is overwritten.
+    Map<String, String> effectiveConf = Maps.newHashMap(conf);
+    String previous = effectiveConf.put(IcebergConstants.CATALOG_BACKEND, "jdbc");
+    if (previous != null && !IcebergCatalogBackend.JDBC.name().equalsIgnoreCase(previous)) {
+      LOG.warn(
+          "cust catalog forces catalog-backend=JDBC; ignored caller-supplied value '{}'", previous);
+    }
+
+    super.initialize(effectiveConf, info, propertiesMetadata);
+  }
+}
