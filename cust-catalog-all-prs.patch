+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import javax.annotation.Nullable;
+import org.apache.gravitino.listener.EventBus;
+import org.apache.gravitino.listener.api.event.Event;
+import org.apache.gravitino.metrics.MetricsSystem;
+import org.apache.iceberg.catalog.TableIdentifier;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Per-catalog facade that bundles metrics counters and event publishing for the cust catalog (spec
+ * §5.6 / PR 6).
+ *
+ * <p>One instance is created by {@link CustIcebergCatalog#initialize} and shared with the {@link
+ * CustTableOperations} instances it creates. All methods are null-safe — when the server has not
+ * registered a {@link MetricsSystem} or {@link EventBus} (e.g. in unit tests without observability
+ * wiring), the calls silently no-op.
+ *
+ * <h2>Lifecycle</h2>
+ *
+ * <ul>
+ *   <li>{@link #create(String)} — called from {@code CustIcebergCatalog.initialize}. Looks up the
+ *       {@link MetricsSystem} from {@link CustObservabilityHolder}, creates and registers a {@link
+ *       CustMetricsSource}.
+ *   <li>{@link #close()} — called from {@code CustIcebergCatalog.close()}. Unregisters the metrics
+ *       source.
+ * </ul>
+ *
+ * <h2>Thread safety</h2>
+ *
+ * The {@link CustMetricsSource} counters and {@link EventBus} are themselves thread-safe. This
+ * class is safe for concurrent use from multiple threads (e.g. parallel commit paths).
+ */
+final class CustObservability {
+
+  private static final Logger LOG = LoggerFactory.getLogger(CustObservability.class);
+
+  @Nullable private final CustMetricsSource metricsSource;
+  @Nullable private final EventBus eventBus;
+  @Nullable private final MetricsSystem metricsSystem;
+  private final String catalogName;
+
+  private CustObservability(
+      String catalogName, @Nullable MetricsSystem metricsSystem, @Nullable EventBus eventBus) {
+    this.catalogName = catalogName;
+    this.metricsSystem = metricsSystem;
+    this.eventBus = eventBus;
+    if (metricsSystem != null) {
+      this.metricsSource = new CustMetricsSource(catalogName);
+      metricsSystem.register(metricsSource);
+    } else {
+      this.metricsSource = null;
+    }
+  }
+
+  /**
+   * Creates a {@link CustObservability} for the given catalog, registering a {@link
+   * CustMetricsSource} with the {@link MetricsSystem} from {@link CustObservabilityHolder} if one
+   * is available.
+   */
+  static CustObservability create(String catalogName) {
+    MetricsSystem ms = CustObservabilityHolder.getMetricsSystem();
+    EventBus eb = CustObservabilityHolder.getEventBus();
+    return new CustObservability(catalogName, ms, eb);
+  }
+
+  /** Unregisters the metrics source from the {@link MetricsSystem} if one was registered. */
+  void close() {
+    if (metricsSystem != null && metricsSource != null) {
+      metricsSystem.unregister(metricsSource);
+    }
+  }
+
+  // ==================== Metrics ====================
+
+  /** Increments the mirror-reads counter. */
+  void incMirrorReads() {
+    if (metricsSource != null) {
+      metricsSource.incMirrorReads();
+    }
+  }
+
+  /** Increments the materialize-events counter. */
+  void incMaterializeEvents() {
+    if (metricsSource != null) {
+      metricsSource.incMaterializeEvents();
+    }
+  }
+
+  /** Increments the conflict-counts counter. */
+  void incConflictCounts() {
+    if (metricsSource != null) {
+      metricsSource.incConflictCounts();
+    }
+  }
+
+  /** Increments the upstream-forwarded-reads counter. */
+  void incUpstreamFwdReads() {
+    if (metricsSource != null) {
+      metricsSource.incUpstreamFwdReads();
+    }
+  }
+
+  /** Returns the metrics source, or {@code null} if not registered. */
+  @Nullable
+  CustMetricsSource metricsSource() {
+    return metricsSource;
+  }
+
+  // ==================== Events ====================
+
+  /** Publishes a {@link CustMirrorReadEvent} for the given identifier. */
+  void publishMirrorRead(TableIdentifier identifier) {
+    publish(new CustMirrorReadEvent(catalogName, identifier));
+  }
+
+  /** Publishes a {@link CustMaterializeEvent} with the committed metadata location. */
+  void publishMaterialize(TableIdentifier identifier, String metadataLocation) {
+    publish(new CustMaterializeEvent(catalogName, identifier, metadataLocation));
+  }
+
+  /** Publishes a {@link CustConflictEvent} with the given conflict reason. */
+  void publishConflict(TableIdentifier identifier, String reason) {
+    publish(new CustConflictEvent(catalogName, identifier, reason));
+  }
+
+  /**
+   * Dispatches an event to the {@link EventBus} if one is available. Exceptions from listeners are
+   * caught and logged so they never disrupt catalog operations.
+   */
+  private void publish(Event event) {
+    if (eventBus == null) {
+      return;
+    }
+    try {
+      eventBus.dispatchEvent(event);
+    } catch (Exception e) {
+      LOG.warn(
+          "Failed to dispatch {} for table '{}' in catalog '{}'; ignoring",
+          event.getClass().getSimpleName(),
+          event.identifier(),
+          catalogName,
+          e);
+    }
+  }
+}
