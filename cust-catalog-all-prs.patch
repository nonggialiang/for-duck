+ * KIND, either express or implied.  See the License for the
+ * specific language governing permissions and limitations
+ * under the License.
+ */
+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import javax.annotation.Nullable;
+import org.apache.gravitino.listener.EventBus;
+import org.apache.gravitino.metrics.MetricsSystem;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/**
+ * Static side-channel for injecting the server-level {@link MetricsSystem} and {@link EventBus}
+ * into {@link CustIcebergCatalog} (spec §8.6 / PR 6).
+ *
+ * <p>This class mirrors the {@link UpstreamLookupHolder} pattern: the cust catalog backend is
+ * instantiated via Iceberg's {@code CatalogUtil.loadCatalog} reflection and cannot directly obtain
+ * the {@code MetricsSystem}/{@code EventBus} from {@code GravitinoEnv} in all deployment
+ * configurations (classloader isolation). The server side (typically {@code
+ * CustCatalogOperations.initialize}) registers them here during catalog initialization; the cust
+ * Iceberg backend reads them lazily on first use.
+ *
+ * <p>In unit tests, the test harness calls the setters directly.
+ *
+ * <p>All methods are thread-safe via {@code volatile}.
+ */
+public final class CustObservabilityHolder {
+
+  private static final Logger LOG = LoggerFactory.getLogger(CustObservabilityHolder.class);
+
+  @Nullable private static volatile MetricsSystem metricsSystem;
+  @Nullable private static volatile EventBus eventBus;
+
+  private CustObservabilityHolder() {}
+
+  /**
+   * Registers the server-level {@link MetricsSystem}.
+   *
+   * @param metricsSystem the metrics system, or {@code null} to clear.
+   */
+  public static void setMetricsSystem(@Nullable MetricsSystem metricsSystem) {
+    CustObservabilityHolder.metricsSystem = metricsSystem;
+    LOG.debug("MetricsSystem set: {}", metricsSystem != null ? "active" : "null");
+  }
+
+  /**
+   * Returns the registered {@link MetricsSystem}, or {@code null} if not set (e.g. in unit tests
+   * without observability wiring).
+   */
+  @Nullable
+  public static MetricsSystem getMetricsSystem() {
+    return metricsSystem;
+  }
+
+  /**
+   * Registers the server-level {@link EventBus}.
+   *
+   * @param eventBus the event bus, or {@code null} to clear.
+   */
+  public static void setEventBus(@Nullable EventBus eventBus) {
+    CustObservabilityHolder.eventBus = eventBus;
+    LOG.debug("EventBus set: {}", eventBus != null ? "active" : "null");
+  }
+
+  /**
+   * Returns the registered {@link EventBus}, or {@code null} if not set (e.g. in unit tests without
+   * observability wiring).
+   */
+  @Nullable
+  public static EventBus getEventBus() {
+    return eventBus;
+  }
+
+  /** Clears the holder. Primarily for test isolation. */
+  public static void clear() {
+    metricsSystem = null;
+    eventBus = null;
+  }
+}
