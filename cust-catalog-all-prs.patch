+
+  private final String metadataLocation;
+
+  /**
+   * Constructs a materialize event.
+   *
+   * @param catalogName the cust catalog name.
+   * @param identifier the Iceberg table identifier that was materialized.
+   * @param metadataLocation the metadata JSON location of the newly materialized table (under the
+   *     catalog-a warehouse).
