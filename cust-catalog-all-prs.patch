+    if (!localTableExists(identifier)) {
+      if (upstream().tableExists(identifier)) {
+        throw new ForbiddenException(
+            "Cannot drop unmaterialized mirror table '%s': it has no local entry in catalog-a "
+                + "(the data lives in catalog-b). To remove it from catalog-a's view, drop it "
+                + "directly from catalog-b.",
