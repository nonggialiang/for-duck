+
+/**
+ * Unit tests for cust catalog events (spec §5.6 / PR 6).
+ *
+ * <p>Verifies that {@link EventBus} receives the correct event types when the corresponding code
+ * paths are exercised through {@link CustIcebergCatalog}:
+ *
+ * <ul>
+ *   <li>Mirror read → {@link CustMirrorReadEvent}
+ *   <li>First-write materialization → {@link CustMaterializeEvent}
+ *   <li>Concurrent first-write conflict → {@link CustConflictEvent}
+ * </ul>
+ *
+ * <p>The test creates a real {@link EventBus} with a Mockito-mock {@link EventListenerPlugin},
+ * injects it via {@link CustObservabilityHolder}, and verifies events via {@code verify()}.
+ */
+public class TestCustEvents {
+
+  private static final String UPSTREAM_CATALOG_NAME = "catalog-b";
+  private static final String UPSTREAM_WAREHOUSE = "s3://bucket-b/warehouse";
+  private static final String CATALOG_NAME = "cust-a";
+
+  @TempDir File tempDir;
+
+  private EventBus eventBus;
+  private EventListenerPlugin mockListener;
+  private CustIcebergCatalog catalog;
+  private org.apache.iceberg.catalog.Catalog mockUpstream;
+  private UpstreamLookup mockLookup;
+  private String localWarehouse;
+
+  @BeforeEach
+  void setUp() {
+    mockListener = mock(EventListenerPlugin.class);
+    eventBus = new EventBus(List.of(mockListener));
+    CustObservabilityHolder.setEventBus(eventBus);
+
+    mockUpstream = mock(org.apache.iceberg.catalog.Catalog.class);
+    mockLookup = name -> mockUpstream;
+    localWarehouse = tempDir.toPath().resolve("warehouse").toString();
+    catalog = new CustIcebergCatalog(mockLookup);
+    catalog.setConf(new org.apache.hadoop.hdfs.HdfsConfiguration());
+    catalog.initialize(CATALOG_NAME, baseProps());
+  }
+
+  @AfterEach
+  void tearDown() {
+    CustObservabilityHolder.clear();
+    if (catalog != null) {
+      try {
+        catalog.close();
+      } catch (Exception ignored) {
+        // Best-effort cleanup.
+      }
+    }
+  }
+
+  private Map<String, String> baseProps() {
+    Map<String, String> p = new HashMap<>();
+    p.put(CatalogProperties.WAREHOUSE_LOCATION, localWarehouse);
+    p.put(CatalogProperties.URI, "jdbc:sqlite:" + tempDir.toPath().resolve("cust-events.db"));
+    p.put(IcebergConstants.GRAVITINO_JDBC_DRIVER, "org.sqlite.JDBC");
+    p.put("upstream-catalog", UPSTREAM_CATALOG_NAME);
+    p.put(IcebergConstants.ICEBERG_JDBC_SCHEMA_VERSION, "V1");
+    p.put(IcebergConstants.ICEBERG_JDBC_STRICT_MODE, "false");
+    return p;
+  }
+
+  private static Schema simpleSchema() {
+    return new Schema(List.of(NestedField.optional(1, "id", Types.LongType.get())));
+  }
+
+  private static TableMetadata buildUpstreamMetadata(TableIdentifier ident) {
+    return TableMetadata.newTableMetadata(
+        simpleSchema(),
+        PartitionSpec.unpartitioned(),
+        SortOrder.unsorted(),
+        UPSTREAM_WAREHOUSE + "/" + ident.namespace().toString() + "/" + ident.name(),
+        Collections.emptyMap());
+  }
+
+  private static Table mockUpstreamTable(TableIdentifier ident, TableMetadata meta) {
+    FileIO mockIo = mock(FileIO.class);
+    TableOperations mockOps = mock(TableOperations.class);
+    when(mockOps.current()).thenReturn(meta);
+    when(mockOps.io()).thenReturn(mockIo);
+    return new BaseTable(mockOps, "upstream." + ident.name());
+  }
+
+  private static TableOperations ops(Table table) {
+    Assertions.assertTrue(table instanceof BaseTable);
+    return ((BaseTable) table).operations();
+  }
+
+  /** Mirror read publishes a {@link CustMirrorReadEvent}. */
+  @Test
+  void testMirrorReadEvent() {
+    Namespace ns = Namespace.of("ns_evt_mirror");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_mirror_evt");
+
+    Table upstreamTable = mockUpstreamTable(ident, buildUpstreamMetadata(ident));
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    catalog.loadTable(ident);
+
+    verify(mockListener, atLeastOnce()).onPostEvent(argThat(e -> e instanceof CustMirrorReadEvent));
+  }
+
+  /** Successful materialization publishes a {@link CustMaterializeEvent}. */
+  @Test
+  void testMaterializeEvent() {
+    Namespace ns = Namespace.of("ns_evt_mat");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_mat_evt");
+
+    Table upstreamTable = mockUpstreamTable(ident, buildUpstreamMetadata(ident));
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    Table loaded = catalog.loadTable(ident);
+    TableMetadata base = ops(loaded).current();
+    Map<String, String> props = new HashMap<>(base.properties());
+    props.put("cust.event", "test");
+    TableMetadata newMeta = TableMetadata.buildFrom(base).setProperties(props).build();
+
+    ops(loaded).commit(base, newMeta);
+
+    verify(mockListener, atLeastOnce())
+        .onPostEvent(argThat(e -> e instanceof CustMaterializeEvent));
+    // Materialize event should carry the metadata location in customInfo.
+    verify(mockListener, atLeastOnce())
+        .onPostEvent(
+            argThat(
+                e ->
+                    e instanceof CustMaterializeEvent
+                        && ((CustMaterializeEvent) e)
+                            .customInfo()
+                            .containsKey("metadata-location")));
+  }
+
+  /** Concurrent first-write conflict publishes a {@link CustConflictEvent}. */
+  @Test
+  void testConflictEvent() {
+    Namespace ns = Namespace.of("ns_evt_conf");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_conf_evt");
+
+    Table upstreamTable = mockUpstreamTable(ident, buildUpstreamMetadata(ident));
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    // Both A and B load the unmaterialized mirror.
+    Table aLoad = catalog.loadTable(ident);
+    Table bLoad = catalog.loadTable(ident);
+    TableMetadata aBase = ops(aLoad).current();
+    TableMetadata bBase = ops(bLoad).current();
+
+    // A commits — materializes.
+    Map<String, String> aProps = new HashMap<>(aBase.properties());
+    aProps.put("winner", "A");
+    ops(aLoad).commit(aBase, TableMetadata.buildFrom(aBase).setProperties(aProps).build());
+
+    // B's stale CustTableOperations tries to commit — conflict.
+    Map<String, String> bProps = new HashMap<>(bBase.properties());
+    bProps.put("winner", "B");
+    Assertions.assertThrows(
+        org.apache.iceberg.exceptions.CommitFailedException.class,
+        () ->
+            ops(bLoad).commit(bBase, TableMetadata.buildFrom(bBase).setProperties(bProps).build()));
+
+    // Conflict event should have been published.
+    verify(mockListener, atLeastOnce()).onPostEvent(argThat(e -> e instanceof CustConflictEvent));
+  }
+
+  /** All cust events should carry {@link EventSource#GRAVITINO_ICEBERG_REST_SERVER}. */
+  @Test
+  void testEventSourceIsIcebergRest() {
+    Namespace ns = Namespace.of("ns_evt_src");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_src");
+
+    Table upstreamTable = mockUpstreamTable(ident, buildUpstreamMetadata(ident));
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    catalog.loadTable(ident);
+
+    verify(mockListener, atLeastOnce())
+        .onPostEvent(
+            argThat(
+                e ->
+                    e instanceof CustMirrorReadEvent
+                        && e.eventSource() == EventSource.GRAVITINO_ICEBERG_REST_SERVER));
+  }
+
+  /** All cust events should carry the catalog name and Iceberg table identifier in customInfo. */
+  @Test
+  void testEventCustomInfo() {
+    Namespace ns = Namespace.of("ns_evt_info");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_info");
+
+    Table upstreamTable = mockUpstreamTable(ident, buildUpstreamMetadata(ident));
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    catalog.loadTable(ident);
+
+    verify(mockListener, atLeastOnce())
+        .onPostEvent(
+            argThat(
+                e -> {
+                  if (!(e instanceof CustMirrorReadEvent)) {
+                    return false;
+                  }
+                  Map<String, String> info = e.customInfo();
+                  return CATALOG_NAME.equals(info.get("catalog-name"))
+                      && "cust".equals(info.get("catalog-type"))
+                      && ident.toString().equals(info.get("iceberg-table"));
+                }));
+  }
+}
