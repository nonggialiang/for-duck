+    List<TableIdentifier> tables = catalog.listTables(ns);
+    Assertions.assertTrue(
+        tables.contains(TableIdentifier.of(ns, "tbl_in_local")),
+        "local identifier should be present: " + tables);
+    Assertions.assertTrue(
+        tables.contains(upstreamIdent), "upstream identifier should be present: " + tables);
+    Assertions.assertEquals(2, tables.size(), "union should have exactly 2 entries: " + tables);
+  }
+
+  /** Local-only identifier appears once even when upstream also reports it (no duplicates). */
+  @Test
+  void testListTablesDedupsLocalAndUpstream() {
+    Namespace ns = Namespace.of("ns_dedup");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_both");
+    catalog.createTable(ident, simpleSchema());
+    when(mockUpstream.listTables(ns)).thenReturn(List.of(ident));
+
+    List<TableIdentifier> tables = catalog.listTables(ns);
+    Assertions.assertEquals(1, tables.size(), "expected dedup to 1: " + tables);
+    Assertions.assertEquals(ident, tables.get(0));
+  }
+
+  /** {@code metadataLocation} returns null when the table is not materialized locally. */
+  @Test
+  void testMetadataLocationNullForUnmaterialized() {
+    TableIdentifier ident = TableIdentifier.of(Namespace.of("ns_meta"), "tbl_meta");
+    Assertions.assertNull(catalog.metadataLocation(ident));
+  }
+
+  /** {@code metadataLocation} returns the JDBC-stored path when the table is materialized. */
+  @Test
+  void testMetadataLocationSetForMaterialized() {
+    Namespace ns = Namespace.of("ns_meta2");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_meta2");
+    catalog.createTable(ident, simpleSchema());
+    String loc = catalog.metadataLocation(ident);
+    Assertions.assertNotNull(loc, "materialized table should have a JDBC-stored metadata location");
+    Assertions.assertTrue(
+        loc.startsWith(localWarehouse) || loc.startsWith("file:") || loc.startsWith("/"),
+        "metadata location should look like a path, got: " + loc);
+  }
+
+  /**
+   * Building a mock upstream Table whose {@code operations().current()} returns a real metadata.
+   */
+  private Table mockUpstreamTable(TableIdentifier ident) {
+    Schema schema = new Schema(NestedField.optional(1, "id", Types.LongType.get()));
+    TableMetadata upstreamMeta =
+        TableMetadata.newTableMetadata(
+            schema,
+            PartitionSpec.unpartitioned(),
+            SortOrder.unsorted(),
+            UPSTREAM_WAREHOUSE + "/" + ident.namespace().toString() + "/" + ident.name(),
+            Collections.emptyMap());
+    FileIO mockIo = mock(FileIO.class);
+    TableOperations mockOps = mock(TableOperations.class);
+    when(mockOps.current()).thenReturn(upstreamMeta);
+    when(mockOps.io()).thenReturn(mockIo);
+    return new BaseTable(mockOps, "upstream." + ident.name());
+  }
+}
