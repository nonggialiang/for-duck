index 000000000..8046d27af
--- /dev/null
+++ b/catalogs/catalog-lakehouse-cust/src/main/java/org/apache/gravitino/catalog/lakehouse/cust/CustObservability.java
@@ -0,0 +1,165 @@
+/*
