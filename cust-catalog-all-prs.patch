+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import static org.apache.gravitino.connector.PropertyEntry.stringRequiredPropertyEntry;
+
+import com.google.common.collect.ImmutableList;
+import com.google.common.collect.ImmutableMap;
+import com.google.common.collect.Maps;
+import java.util.Map;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalogPropertiesMetadata;
+import org.apache.gravitino.connector.PropertyEntry;
+
+/**
+ * Properties metadata for the {@code cust} catalog (catalog-a).
+ *
+ * <p>Extends {@link IcebergCatalogPropertiesMetadata} so that the existing {@code
+ * IcebergCatalogOperations} initialization (which casts the resolved properties metadata to {@code
+ * IcebergCatalogPropertiesMetadata}) keeps working when {@code CustCatalogOperations} delegates to
+ * it.
+ *
+ * <p>The cust catalog only adds one new top-level property on top of the standard Iceberg catalog
+ * properties:
+ *
+ * <ul>
+ *   <li>{@value #UPSTREAM_CATALOG} — the name of the upstream catalog (catalog-b) in the same
+ *       metalake and same Iceberg REST Server instance. Required.
+ * </ul>
+ *
+ * <p>The Iceberg {@code catalog-backend} property is still declared (inherited from the parent) for
+ * validation, but {@link CustCatalogOperations#initialize} forces it to {@code jdbc} regardless of
+ * the user-supplied value.
+ */
+public class CustCatalogPropertiesMetadata extends IcebergCatalogPropertiesMetadata {
+
+  /** Property key for the upstream catalog (catalog-b) name. */
+  public static final String UPSTREAM_CATALOG = "upstream-catalog";
+
+  private static final Map<String, PropertyEntry<?>> PROPERTIES_METADATA =
+      buildPropertiesMetadata();
+
+  /**
+   * Builds the merged property-entries map by inheriting the parent's Iceberg catalog entries and
+   * adding the cust-specific {@code upstream-catalog} entry.
+   *
+   * <p>Note: {@code IcebergCatalogPropertiesMetadata#specificPropertyEntries()} is {@code
+   * protected}, so it cannot be invoked on an unrelated instance of the parent from a different
+   * package. We work around this by calling {@code super.specificPropertyEntries()} from a private
+   * instance method on a carrier instance of this subclass.
+   */
+  private static Map<String, PropertyEntry<?>> buildPropertiesMetadata() {
+    Map<String, PropertyEntry<?>> inherited =
+        new CustCatalogPropertiesMetadata().readInheritedPropertyEntries();
+
+    Map<String, PropertyEntry<?>> result = Maps.newHashMap(inherited);
+
+    // Add cust-specific property entries on top.
+    ImmutableList.<PropertyEntry<?>>of(
+            stringRequiredPropertyEntry(
+                UPSTREAM_CATALOG,
+                "Name of the upstream Iceberg catalog (catalog-b) in the same metalake and "
+                    + "same Iceberg REST Server instance",
+                false /* immutable */,
+                false /* hidden */))
+        .forEach(e -> result.put(e.getName(), e));
+
+    return ImmutableMap.copyOf(result);
+  }
+
+  /**
+   * Reads the inherited Iceberg catalog property entries via {@code super}, the only way to access
+   * the protected parent method from a different package.
+   */
+  private Map<String, PropertyEntry<?>> readInheritedPropertyEntries() {
+    return super.specificPropertyEntries();
+  }
+
+  @Override
+  protected Map<String, PropertyEntry<?>> specificPropertyEntries() {
+    return PROPERTIES_METADATA;
+  }
+
+  /**
+   * Helper for {@link CustCatalogOperations} to read the required upstream-catalog property from
+   * the raw config map without re-resolving the full metadata.
+   *
+   * @param config the raw config map
+   * @return the upstream catalog name
+   * @throws IllegalArgumentException if the property is missing or blank
+   */
+  public static String readUpstreamCatalog(Map<String, String> config) {
+    String value = config.get(UPSTREAM_CATALOG);
+    if (value == null || value.isEmpty()) {
+      throw new IllegalArgumentException(
+          "Required property '" + UPSTREAM_CATALOG + "' is missing for cust catalog");
+    }
+    return value;
+  }
+}
