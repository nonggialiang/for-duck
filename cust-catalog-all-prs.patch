+  /**
+   * Concurrent first-write (spec §5.2.2): with N writers racing to materialize the same
+   * unmaterialized mirror table, exactly one should succeed and the rest should receive a {@link
+   * CommitFailedException}. After the race, the table must be observably materialized so that a
+   * client retry (via {@code loadTable}) sees the MATERIALIZED state.
+   *
+   * <p>The JDBC backend's UNIQUE constraint on {@code (catalog_name, table_namespace, table_name)}
+   * provides the CAS; the wrapping in {@link CustTableOperations#commit} surfaces the loser's
+   * {@link org.apache.iceberg.exceptions.AlreadyExistsException} as the standard Iceberg conflict
+   * signal.
+   *
+   * <p>To guarantee all N writers actually race, the main thread pre-loads N independent {@link
+   * CustTableOperations} instances BEFORE spawning the concurrent commits. Each pre-load captures
+   * the unmaterialized mirror state; the commits are then fired in parallel against the same JDBC
+   * backend.
+   */
+  @Test
+  void testConcurrentFirstMaterialize() throws Exception {
+    final int n = 8;
+    Namespace ns = Namespace.of("ns_race");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_race");
+
+    // Upstream has the table.
+    TableMetadata upstreamMeta = buildUpstreamMetadata(ident);
+    Table upstreamTable = mockUpstreamTable(ident, upstreamMeta);
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    // Pre-load N independent CustTableOperations instances. Each captures the unmaterialized
+    // mirror state at load time and holds its own underlying JdbcTableOperations.
+    Table[] loads = new Table[n];
+    TableMetadata[] bases = new TableMetadata[n];
+    TableMetadata[] newMetas = new TableMetadata[n];
+    for (int i = 0; i < n; i++) {
+      loads[i] = catalog.loadTable(ident);
+      Assertions.assertTrue(
+          ops(loads[i]) instanceof CustTableOperations,
+          "precondition: pre-load " + i + " should return CustTableOperations");
+      bases[i] = ops(loads[i]).current();
+      Map<String, String> props = new HashMap<>(bases[i].properties());
+      props.put("cust.committer", "thread-" + i);
+      newMetas[i] = TableMetadata.buildFrom(bases[i]).setProperties(props).build();
+    }
+
+    // Fire all N commits in parallel.
+    ExecutorService executor = Executors.newFixedThreadPool(n);
+    AtomicInteger successes = new AtomicInteger(0);
+    AtomicInteger conflicts = new AtomicInteger(0);
+    List<java.util.concurrent.Future<Void>> futures = new ArrayList<>(n);
+
+    for (int i = 0; i < n; i++) {
+      final int idx = i;
+      futures.add(
+          executor.submit(
+              () -> {
+                try {
+                  ops(loads[idx]).commit(bases[idx], newMetas[idx]);
+                  successes.incrementAndGet();
+                } catch (CommitFailedException e) {
+                  conflicts.incrementAndGet();
+                }
+                return null;
+              }));
+    }
+
+    for (java.util.concurrent.Future<Void> f : futures) {
+      f.get(30, TimeUnit.SECONDS);
+    }
+    executor.shutdown();
+    Assertions.assertTrue(
+        executor.awaitTermination(10, TimeUnit.SECONDS), "executor should terminate cleanly");
+
+    Assertions.assertEquals(1, successes.get(), "exactly one writer should win the race");
+    Assertions.assertEquals(
+        n - 1, conflicts.get(), "all other writers should receive CommitFailedException");
+
+    // The table must now be observably materialized — a retrying client sees MATERIALIZED state.
+    Assertions.assertTrue(
+        catalog.tableExists(ident), "table should be materialized after the race");
+
+    Table reloaded = catalog.loadTable(ident);
+    Assertions.assertFalse(
+        ops(reloaded) instanceof CustTableOperations,
+        "post-race loadTable should return standard JdbcTableOperations, not CustTableOperations");
+    Assertions.assertNotNull(
+        ops(reloaded).current().property("cust.committer", null),
+        "the winning commit's property should be persisted");
+  }
+
+  /**
+   * Verifies the retry-after-conflict path: when client B loaded the unmaterialized mirror BEFORE
+   * client A materialized it, B's stale CustTableOperations must surface {@link
+   * CommitFailedException}. After B reloads, it sees the materialized table and a regular update
+   * succeeds (no second materialization).
+   */
+  @Test
+  void testRetryAfterConflictSeesMaterialized() {
+    Namespace ns = Namespace.of("ns_retry");
+    TableIdentifier ident = TableIdentifier.of(ns, "tbl_retry");
+
+    // Setup upstream.
+    TableMetadata upstreamMeta = buildUpstreamMetadata(ident);
+    Table upstreamTable = mockUpstreamTable(ident, upstreamMeta);
+    when(mockUpstream.loadTable(ident)).thenReturn(upstreamTable);
+
+    // BOTH clients load the unmaterialized mirror BEFORE either commits. This is the key
+    // precondition for the conflict scenario: each client captured the upstreamBase snapshot.
+    Table aLoad = catalog.loadTable(ident);
+    Table bLoad = catalog.loadTable(ident);
+    Assertions.assertTrue(ops(aLoad) instanceof CustTableOperations, "A pre-condition");
+    Assertions.assertTrue(ops(bLoad) instanceof CustTableOperations, "B pre-condition");
+
+    TableMetadata aBase = ops(aLoad).current();
+    TableMetadata bBase = ops(bLoad).current();
+
+    // A commits first — materializes the table.
+    Map<String, String> aProps = new HashMap<>(aBase.properties());
+    aProps.put("cust.winner", "A");
+    TableMetadata aMeta = TableMetadata.buildFrom(aBase).setProperties(aProps).build();
+    ops(aLoad).commit(aBase, aMeta);
+
+    // B's stale CustTableOperations still thinks the table is unmaterialized. B's commit must
+    // surface CommitFailedException so the client knows to reload.
+    Map<String, String> bProps = new HashMap<>(bBase.properties());
+    bProps.put("cust.winner", "B");
+    TableMetadata bMeta = TableMetadata.buildFrom(bBase).setProperties(bProps).build();
+    Assertions.assertThrows(
+        CommitFailedException.class,
+        () -> ops(bLoad).commit(bBase, bMeta),
+        "loser of the CAS must surface CommitFailedException so the client retries");
+
+    // B retries: reload, observe the materialized table, do a regular update on top of A's commit.
+    Table bReloaded = catalog.loadTable(ident);
+    Assertions.assertFalse(
+        ops(bReloaded) instanceof CustTableOperations,
+        "retry should load the now-materialized table via the standard path");
+    TableMetadata bCurrent = ops(bReloaded).current();
+    Assertions.assertEquals(
+        "A", bCurrent.property("cust.winner", null), "retry should observe A's committed value");
+
+    Map<String, String> bRetryProps = new HashMap<>(bCurrent.properties());
+    bRetryProps.put("cust.winner", "B");
+    TableMetadata bRetry = TableMetadata.buildFrom(bCurrent).setProperties(bRetryProps).build();
+    ops(bReloaded).commit(bCurrent, bRetry);
+
+    // Verify B's retry landed.
+    Table finalLoad = catalog.loadTable(ident);
+    Assertions.assertEquals(
+        "B",
+        ops(finalLoad).current().property("cust.winner", null),
+        "retry commit should have updated the property");
+  }
 }
