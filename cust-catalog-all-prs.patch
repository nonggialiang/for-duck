+package org.apache.gravitino.catalog.lakehouse.cust;
+
+import com.google.common.collect.ImmutableMap;
+import java.util.Map;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergCatalogPropertiesMetadata;
+import org.apache.gravitino.catalog.lakehouse.iceberg.IcebergConstants;
+import org.apache.gravitino.connector.PropertiesMetadata;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Unit tests for {@link CustCatalogPropertiesMetadata}.
+ *
+ * <p>Validates that the cust catalog metadata (a) inherits all Iceberg catalog properties and (b)
+ * adds the required {@code upstream-catalog} property on top.
+ */
+public class TestCustCatalogPropertiesMetadata {
+
+  private CustCatalogPropertiesMetadata metadata;
+
+  @BeforeEach
+  void setUp() {
+    metadata = new CustCatalogPropertiesMetadata();
+  }
+
+  @Test
+  void testUpstreamCatalogPropertyIsDeclared() {
+    Assertions.assertTrue(
+        metadata.containsProperty(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG),
+        "upstream-catalog must be declared in CustCatalogPropertiesMetadata");
+    Assertions.assertTrue(
+        metadata.isRequiredProperty(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG),
+        "upstream-catalog must be a required property");
+    Assertions.assertFalse(
+        metadata.isHiddenProperty(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG),
+        "upstream-catalog must be visible (not hidden)");
+  }
+
+  @Test
+  void testInheritsIcebergCatalogBackendProperty() {
+    // Sanity check: the inherited Iceberg catalog-backend property must still be present.
+    Assertions.assertTrue(metadata.containsProperty(IcebergConstants.CATALOG_BACKEND));
+    Assertions.assertTrue(metadata.containsProperty(IcebergConstants.WAREHOUSE));
+    Assertions.assertTrue(metadata.containsProperty(IcebergConstants.URI));
+  }
+
+  @Test
+  void testReadUpstreamCatalogRejectsMissingKey() {
+    Map<String, String> emptyConfig = ImmutableMap.of();
+    IllegalArgumentException ex =
+        Assertions.assertThrows(
+            IllegalArgumentException.class,
+            () -> CustCatalogPropertiesMetadata.readUpstreamCatalog(emptyConfig));
+    Assertions.assertTrue(ex.getMessage().contains(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG));
+  }
+
+  @Test
+  void testReadUpstreamCatalogRejectsBlankValue() {
+    Map<String, String> blankConfig =
+        ImmutableMap.of(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG, "");
+    Assertions.assertThrows(
+        IllegalArgumentException.class,
+        () -> CustCatalogPropertiesMetadata.readUpstreamCatalog(blankConfig));
+  }
+
+  @Test
+  void testReadUpstreamCatalogReturnsValue() {
+    Map<String, String> config =
+        ImmutableMap.of(CustCatalogPropertiesMetadata.UPSTREAM_CATALOG, "catalog-b");
+    Assertions.assertEquals("catalog-b", CustCatalogPropertiesMetadata.readUpstreamCatalog(config));
+  }
+
+  @Test
+  void testPropertyEntriesCountIsStrictlyLargerThanParent() {
+    // The cust metadata must be a strict superset of the parent Iceberg metadata entries.
+    PropertiesMetadata parent = new IcebergCatalogPropertiesMetadata();
+    int parentCount = parent.propertyEntries().size();
+    int custCount = metadata.propertyEntries().size();
+    Assertions.assertTrue(
+        custCount > parentCount,
+        "Cust metadata must declare strictly more entries than parent (parent="
+            + parentCount
+            + ", cust="
+            + custCount
+            + ")");
+  }
+}
